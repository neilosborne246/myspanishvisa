.msv-nav__cta {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 1.2rem;
  background: var(--red);
  color: #fff !important;
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s, box-shadow 0.15s;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(190,0,17,0.3);
}
.msv-nav__cta:hover {
  background: var(--red-deep);
  box-shadow: 0 4px 14px rgba(190,0,17,0.4);
  text-decoration: none;
}

/* Hamburger */
.msv-nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  border-radius: 5px;
}
.msv-nav__burger span {
  width: 22px;
  height: 2px;
  background: #fff;
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
  display: block;
}

/* Mobile nav */
.msv-nav__mobile {
  display: none;
  flex-direction: column;
  background: var(--navy-mid);
  padding: 1rem 1.5rem 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.msv-nav__mobile.open { display: flex; }
.msv-nav__mobile a {
  padding: 0.65rem 0;
  color: rgba(255,255,255,0.9);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.msv-nav__mobile a:hover { color: var(--yellow); }
.msv-nav__mobile .msv-nav__mobile-sub {
  padding-left: 1rem;
  font-size: 0.88rem;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
}
.msv-nav__mobile-cta {
  margin-top: 1rem;
  background: var(--red);
  color: #fff !important;
  border-radius: 6px;
  text-align: center;
  padding: 0.75rem 1rem !important;
  border-bottom: none !important;
}

@media (max-width: 900px) {
  .msv-nav__links { display: none; }
