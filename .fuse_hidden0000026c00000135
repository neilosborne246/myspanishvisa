/* Links */
.msv-nav__links {
  display: flex;
  align-items: center;
  gap: 0;
  list-style: none;
  margin: 0;
  padding: 0;
}
.msv-nav__links > li {
  position: relative;
}
.msv-nav__links > li > a,
.msv-nav__links > li > button {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.5rem 0.9rem;
  font-size: 0.87rem;
  font-weight: 600;
  color: rgba(255,255,255,0.85);
  text-decoration: none;
  background: none;
  border: none;
  cursor: pointer;
  border-radius: 5px;
  transition: color 0.15s, background 0.15s;
  white-space: nowrap;
  height: 64px;
}
.msv-nav__links > li > a:hover,
.msv-nav__links > li > button:hover,
.msv-nav__links > li:focus-within > a,
.msv-nav__links > li:focus-within > button {
  color: #fff;
  background: rgba(255,255,255,0.08);
}
.msv-nav__chevron {
  font-size: 0.65rem;
  opacity: 0.7;
  transition: transform 0.2s;
}
.msv-nav__links > li:focus-within .msv-nav__chevron,
.msv-nav__links > li:hover .msv-nav__chevron {
  transform: rotate(180deg);
}

/* Dropdown */
.msv-nav__dropdown {
  display: none;
  position: absolute;
  top: 100%;
  left: 0;
  min-width: 230px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  box-shadow: var(--shadow-md);
  padding: 0.5rem 0;
  z-index: 200;
}
.msv-nav__links > li:hover .msv-nav__dropdown,
.msv-nav__links > li:focus-within .msv-nav__dropdown {
  display: block;
}
.msv-nav__dropdown a {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy);
  text-decoration: none;
  transition: background 0.12s;
}
.msv-nav__dropdown a:hover {
  background: var(--cream);
  color: var(--red);
}
.msv-nav__dropdown-icon {
  width: 24px;
  height: 24px;
  background: var(--cream);
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  flex-shrink: 0;
}
.msv-nav__dropdown-divider {
  height: 1px;
  background: var(--border);
  margin: 0.4rem 0;
}

/* CTA button */
.msv-nav__cta {
  display: inline-flex;
  align-items: center;
  padding: 0.55rem 1.2rem;
  background: var(--red);
  color: #fff !important;
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s, box-shadow 0.15s;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(190,0,17,0.3);
}
.msv-nav__cta:hover {
  background: var(--red-deep);
  box-shadow: 0 4px 14px rgba(190,0,17,0.4);
  text-decoration: none;
}

/* Hamburger */
.msv-nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  border-radius: 5px;
}
.msv-nav__burger span {
  width: 22px;
  height: 2px;
  background: #fff;
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
  display: block;
}

/* Mobile nav */
.msv-nav__mobile {
  display: none;
  flex-direction: column;
  background: var(--navy-mid);
  padding: 1rem 1.5rem 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.msv-nav__mobile.open { display: flex; }
.msv-nav__mobile a {
  padding: 0.65rem 0;
  color: rgba(255,255,255,0.9);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.msv-nav__mobile a:hover { color: var(--yellow); }
.msv-nav__mobile .msv-nav__mobile-sub {
  padding-left: 1rem;
  font-size: 0.88rem;
  font-weight: 500;
  color: rgba(255,255,255,0.7);
}
.msv-nav__mobile-cta {
  margin-top: 1rem;
