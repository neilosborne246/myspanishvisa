        </div>
        <div style="display: flex; gap: 1rem; align-items: flex-start;">
          <div style="flex-shrink: 0; width: 32px; height: 32px; background: linear-gradient(135deg, var(--red), var(--red-deep)); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800; font-size: 0.8rem;">2</div>
