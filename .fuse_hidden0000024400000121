  z-index: 200;
}
.msv-nav__links > li:hover .msv-nav__dropdown,
.msv-nav__links > li:focus-within .msv-nav__dropdown {
  display: block;
}
.msv-nav__dropdown a {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy);
  text-decoration: none;
  transition: background 0.12s;
}
.msv-nav__dropdown a:hover {
  background: var(--cream);
  color: var(--red);
}
.msv-nav__dropdown-icon {
  width: 24px;
  height: 24px;
  background: var(--cream);
  border-radius: 5px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.85rem;
  flex-shrink: 0;
}
