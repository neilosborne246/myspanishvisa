  --info-bg:    #e8edf6;
  --shadow-sm:  0 2px 8px rgba(12,25,48,0.08);
  --shadow-md:  0 6px 24px rgba(12,25,48,0.13);
  --shadow-lg:  0 12px 40px rgba(12,25,48,0.18);

  font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.75;
  color: var(--black);
  width: 100%;
}

/* ── Inner container ──────────────────────────────────────────────── */
.msv__container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
}
@media (max-width: 640px) {
  .msv__container { padding: 0 1.2rem; }
}

/* ── Typography ───────────────────────────────────────────────────── */
.msv h1 {
  font-size: clamp(2rem, 4.5vw, 3rem);
  font-weight: 800;
  line-height: 1.15;
  color: var(--white);
  letter-spacing: -0.02em;
  margin-bottom: 1.2rem;
}
.msv h2 {
  font-size: clamp(1.35rem, 2.8vw, 1.85rem);
  font-weight: 700;
  color: var(--navy);
  letter-spacing: -0.01em;
  margin-bottom: 0.5rem;
  position: relative;
  display: inline-block;
  padding-bottom: 0.5rem;
}
.msv h2::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0;
  width: 48px; height: 3px;
  background: linear-gradient(90deg, var(--red), var(--red-deep));
  border-radius: 2px;
}
.msv h3 {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--navy);
  margin-bottom: 0.35rem;
}
.msv p { color: var(--black); margin-bottom: 1rem; font-size: 0.97rem; }

/* ── Anchor base — never let generic link colour bleed into buttons ── */
.msv a { color: var(--red); text-decoration: none; }
.msv a:hover { text-decoration: underline; }

/* ── Sections ─────────────────────────────────────────────────────── */
.msv__section { padding: 6.5rem 0; background: var(--white); }
.msv__section--cream {
  padding: 6.5rem 0;
  background: linear-gradient(180deg, #f8f7f4 0%, #f2f4f8 100%);
}
.msv__section--dark {
  padding: 6.5rem 0;
  background: linear-gradient(135deg, var(--navy) 0%, #0d2240 55%, #0a1d38 100%);
}
.msv__section--dark h2 { color: var(--white) !important; }
.msv__section--dark h2::after { background: linear-gradient(90deg, var(--yellow), #e8b820); }
.msv__section--dark h3 { color: rgba(255,255,255,0.9) !important; }
.msv__section--dark p  { color: rgba(255,255,255,0.82); }
@media (max-width: 640px) { .msv__section, .msv__section--cream { padding: 3.5rem 0; } }

/* ── Hero ─────────────────────────────────────────────────────────── */
.msv__hero {
  background: linear-gradient(135deg, #0c1930 0%, #0f2540 45%, #162d50 75%, #1a3560 100%);
  padding: 6rem 0 5rem;
  position: relative;
  overflow: hidden;
}
.msv__hero::before {
  content: '';
  position: absolute;
  top: -40%; right: -10%;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(190,0,17,0.12) 0%, transparent 70%);
  pointer-events: none;
}
.msv__hero::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(250,207,57,0.4), transparent);
}
.msv__hero-inner { max-width: 780px; }
.msv__eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  background: rgba(190,0,17,0.15);
  border: 1px solid rgba(190,0,17,0.4);
  color: #ff6b7a;
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 0.35rem 0.9rem;
  border-radius: 100px;
  margin-bottom: 1.5rem;
}
.msv__eyebrow::before {
  content: '';
  width: 6px; height: 6px;
  background: var(--red);
  border-radius: 50%;
  box-shadow: 0 0 6px var(--red);
}
.msv__hero-sub {
  font-size: clamp(1rem, 2vw, 1.15rem);
  color: rgba(255,255,255,0.78) !important;
  max-width: 600px;
  margin-bottom: 2.2rem;
  line-height: 1.7;
}
.msv__hero p { color: rgba(255,255,255,0.78) !important; }
.msv__hero-trust {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.45);
  margin-top: 2rem;
  padding-top: 1.25rem;
  border-top: 1px solid rgba(255,255,255,0.1);
  letter-spacing: 0.02em;
}

/* ── Buttons — explicit white text always, high specificity ──────── */
.msv__btn-group { display: flex; flex-wrap: wrap; gap: 0.85rem; }
.msv__btn {
  display: inline-block;
  padding: 0.85rem 2rem;
  font-size: 0.92rem;
  font-weight: 700;
  border-radius: 6px;
  text-decoration: none !important;
  cursor: pointer;
  transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
  letter-spacing: 0.01em;
}
.msv__btn:hover { transform: translateY(-1px); text-decoration: none !important; }
.msv .msv__btn--primary {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #ffffff !important;
  box-shadow: 0 4px 14px rgba(190,0,17,0.35);
}
.msv .msv__btn--primary:hover { box-shadow: 0 6px 20px rgba(190,0,17,0.45); color: #ffffff !important; }
.msv .msv__btn--ghost {
  background: rgba(255,255,255,0.07);
  color: #ffffff !important;
  border: 1.5px solid rgba(255,255,255,0.3);
  backdrop-filter: blur(4px);
}
.msv .msv__btn--ghost:hover { background: rgba(255,255,255,0.13); color: #ffffff !important; }
.msv .msv__btn--navy {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
  color: #ffffff !important;
  box-shadow: var(--shadow-sm);
}
.msv .msv__btn--navy:hover { box-shadow: var(--shadow-md); color: #ffffff !important; }
.msv .msv__btn--outline {
  background: transparent;
  color: var(--navy) !important;
  border: 2px solid var(--navy);
}
.msv .msv__btn--outline:hover { background: var(--navy); color: #ffffff !important; }
.msv .msv__btn--outline-white {
  background: transparent;
  color: #ffffff !important;
  border: 1.5px solid rgba(255,255,255,0.5);
}
.msv .msv__btn--outline-white:hover { background: rgba(255,255,255,0.1); color: #ffffff !important; }

/* ── Trust bar ────────────────────────────────────────────────────── */
.msv__trust-bar {
  background: var(--white);
  border-bottom: 1px solid var(--border);
  padding: 1.1rem 0;
  box-shadow: var(--shadow-sm);
}
.msv__trust-bar-inner {
  display: flex; flex-wrap: wrap;
  justify-content: center; gap: 1.5rem;
}
.msv__trust-item {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 0.8rem; font-weight: 600;
  color: var(--navy); white-space: nowrap;
}
.msv__trust-item::before {
  content: '';
  width: 7px; height: 7px;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  border-radius: 50%;
  flex-shrink: 0;
}

/* ── CTA inline box ───────────────────────────────────────────────── */
.msv__cta-inline {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
  border-radius: 10px;
  padding: 1.6rem 2rem;
  margin: 2.2rem 0;
  display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap;
  box-shadow: var(--shadow-md);
  position: relative; overflow: hidden;
}
.msv__cta-inline::before {
  content: '';
  position: absolute; left: 0; top: 0; bottom: 0;
  width: 4px;
  background: linear-gradient(180deg, var(--red), var(--red-deep));
}
.msv__cta-inline-text {
  flex: 1; min-width: 200px;
  color: #ffffff !important; font-size: 0.97rem; font-weight: 600; margin: 0;
}

/* ── Note / Info boxes ────────────────────────────────────────────── */
.msv__note {
  background: var(--info-bg);
  border-left: 4px solid var(--navy-light);
  border-radius: 0 8px 8px 0;
  padding: 1.2rem 1.6rem;
  margin: 2rem 0;
  font-size: 0.92rem;
  line-height: 1.7;
  color: var(--navy);
}
.msv__note-label {
  display: block;
  font-size: 0.72rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.09em;
  color: var(--navy-light);
  margin-bottom: 0.3rem;
}
.msv__note--warning { background: #fefce8; border-color: #c9a000; }
.msv__note--warning .msv__note-label { color: #7a5c00; }
.msv__note--disclaimer { background: #f5f5f5; border-color: #888; }
.msv__note--disclaimer .msv__note-label { color: #555; }

/* ── Tables ───────────────────────────────────────────────────────── */
.msv__table-wrap {
  overflow-x: auto;
  margin: 1.4rem 0 1.8rem;
  border-radius: 10px;
  box-shadow: var(--shadow-sm);
}
.msv__table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.9rem;
  min-width: 480px;
}
.msv__table th {
  background: linear-gradient(135deg, var(--navy) 0%, var(--navy-mid) 100%);
  color: #ffffff;
  padding: 0.85rem 1.1rem;
  text-align: left;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.msv__table td {
  padding: 0.85rem 1.1rem;
  border-bottom: 1px solid var(--border);
  vertical-align: top;
  color: var(--black);
}
.msv__table tr:nth-child(even) td { background: var(--row-alt); }
.msv__table tr:last-child td { border-bottom: none; }
.msv__pill {
  display: inline-block;
  padding: 0.2rem 0.65rem;
  border-radius: 100px;
  font-size: 0.75rem;
  font-weight: 700;
}
.msv__pill--green { background: #d4edda; color: #1a5c2a; }
.msv__pill--amber { background: #fff3cd; color: #7a5c00; }
.msv__pill--red   { background: #ffe0e3; color: #8c000d; }

/* ── Lists ────────────────────────────────────────────────────────── */
.msv__list {
  list-style: none;
  padding: 0;
  margin: 1rem 0 1.4rem;
}
.msv__list li {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.85rem 0;
  font-size: 0.96rem;
  border-bottom: 1px solid rgba(220,227,237,0.5);
  color: var(--black);
}
.msv__list li:last-child { border-bottom: none; }
.msv__list li::before {
  content: '';
  width: 7px; height: 7px;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 0.52rem;
}
.msv__list--checks li::before {
  content: '✓';
  width: auto; height: auto;
  background: none;
  color: #27ae60;
  font-weight: 800;
  font-size: 0.85rem;
  margin-top: 0.1rem;
}
.msv__section--dark .msv__list li { color: rgba(255,255,255,0.85); border-color: rgba(255,255,255,0.1); }

/* ── Cards ────────────────────────────────────────────────────────── */
.msv__cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
  gap: 2rem;
  margin: 3rem 0;
}
.msv__card {
  background: var(--white);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 2.4rem 2.2rem;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s, transform 0.2s;
}
.msv__card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.msv__card-icon { font-size: 1.8rem; margin-bottom: 0.85rem; display: block; }
.msv__card-title { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.5rem; }
.msv__card p { font-size: 0.88rem; color: var(--muted); margin: 0; }

/* ── Two-route split ──────────────────────────────────────────────── */
.msv__routes {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin: 2rem 0;
}
@media (max-width: 640px) { .msv__routes { grid-template-columns: 1fr; } }
.msv__route {
  border-radius: 12px;
  padding: 1.75rem 1.5rem;
  border: 2px solid var(--border);
}
.msv__route--employee {
  border-color: var(--navy-light);
  background: linear-gradient(135deg, #f0f5fb, #e8edf6);
}
.msv__route--freelance {
  border-color: var(--red);
  background: linear-gradient(135deg, #fdf5f5, #fbeaeb);
}
.msv__route-badge {
  display: inline-block;
  padding: 0.25rem 0.75rem;
  border-radius: 100px;
  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  margin-bottom: 0.85rem;
  color: #ffffff !important;
}
.msv__route--employee .msv__route-badge { background: var(--navy); }
.msv__route--freelance .msv__route-badge { background: var(--red); }
.msv__route h3 { font-size: 1.05rem; margin-bottom: 0.6rem; color: var(--navy) !important; }
.msv__route-cta-note {
  margin-top: 1rem;
  padding: 0.75rem 1rem;
  background: #e8f4f0;
  border-left: 3px solid #2a7a5e;
  border-radius: 0 8px 8px 0;
  font-size: 0.88rem;
  color: #1a4a38;
  line-height: 1.5;
}
.msv__route-cta-note strong { color: #1a4a38; }

/* ── Steps ────────────────────────────────────────────────────────── */
.msv__steps { margin: 2.5rem 0; }
.msv__step {
  display: flex;
  gap: 1.5rem;
  padding: 2rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.1);
  align-items: flex-start;
}
.msv__step:last-child { border-bottom: none; }
.msv__step-num {
  width: 44px; height: 44px;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  color: #ffffff !important;
  font-size: 1rem;
  font-weight: 800;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 3px 10px rgba(190,0,17,0.3);
}
.msv__step-body { flex: 1; }
.msv__step-title { font-size: 1rem; font-weight: 700; color: #ffffff !important; margin-bottom: 0.35rem; }
.msv__step-body p { color: rgba(255,255,255,0.78); }

/* ── Pricing section ──────────────────────────────────────────────── */
.msv__pricing {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin: 2rem 0;
}
@media (max-width: 680px) { .msv__pricing { grid-template-columns: 1fr; } }
.msv__price-card {
  border-radius: 14px;
  border: 2px solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s, transform 0.2s;
}
.msv__price-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.msv__price-card--featured { border-color: var(--red); }
.msv__price-header {
  padding: 1.5rem 1.75rem 1rem;
  background: linear-gradient(135deg, var(--navy), var(--navy-mid));
}
.msv__price-header--featured {
  background: linear-gradient(135deg, var(--red), var(--red-deep));
}
.msv__price-label {
  font-size: 0.72rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.1em;
  color: rgba(255,255,255,0.7);
  margin-bottom: 0.4rem;
}
.msv__price-amount {
  font-size: 2.4rem; font-weight: 900;
  color: #ffffff !important;
  letter-spacing: -0.03em;
  line-height: 1;
}
.msv__price-sub {
  font-size: 0.8rem;
  color: rgba(255,255,255,0.6);
  margin-top: 0.3rem;
}
.msv__price-body {
  padding: 1.4rem 1.75rem 1.75rem;
  background: var(--white);
}
.msv__price-instalment {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.55rem 0;
  border-bottom: 1px solid var(--border);
  font-size: 0.88rem;
}
.msv__price-instalment:last-of-type { border-bottom: none; margin-bottom: 1rem; }
.msv__price-instalment-label { color: var(--muted); }
.msv__price-instalment-amount { font-weight: 700; color: var(--navy); }
.msv__price-includes-title {
  font-size: 0.72rem; font-weight: 800;
  text-transform: uppercase; letter-spacing: 0.08em;
  color: var(--navy-light);
  margin: 1rem 0 0.6rem;
}
.msv__price-includes li {
  font-size: 0.85rem;
  color: var(--muted);
  padding: 0.25rem 0;
  display: flex; gap: 0.5rem; align-items: flex-start;
}
.msv__price-includes li::before {
  content: '✓';
  color: #27ae60;
  font-weight: 800;
  font-size: 0.8rem;
  flex-shrink: 0;
  margin-top: 0.05rem;
}
.msv__price-body .msv__btn { display: block; width: 100%; text-align: center; margin-top: 1.25rem; }

/* ── FAQ ──────────────────────────────────────────────────────────── */
.msv__faq { margin: 1.5rem 0; }
.msv__faq-item {
  border: 1px solid var(--border);
  border-radius: 12px;
  margin-bottom: 1rem;
  overflow: hidden;
  background: var(--white);
  box-shadow: var(--shadow-sm);
}
.msv__faq-q {
  display: flex; align-items: center; justify-content: space-between; gap: 1rem;
  padding: 1.3rem 1.6rem;
  font-size: 0.96rem; font-weight: 700;
  color: var(--navy);
  cursor: pointer; user-select: none;
}
.msv__faq-q::after { content: '+'; font-size: 1.3rem; font-weight: 400; color: var(--red); flex-shrink: 0; line-height: 1; }
.msv__faq-a { padding: 0 1.6rem 1.3rem; font-size: 0.92rem; color: var(--muted); line-height: 1.75; }

/* ── Guides grid (card format) ─────────────────────────────────────── */
.msv__guide-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin: 2.5rem 0;
}
@media (max-width: 900px) { .msv__guide-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 600px) { .msv__guide-grid { grid-template-columns: 1fr; } }

.msv__guide-card {
  display: flex; flex-direction: column; gap: 0.5rem;
  background: var(--white); border: 1px solid var(--border); border-radius: 12px;
  border-top: 4px solid var(--navy);
  padding: 1.6rem 1.5rem 1.4rem;
  text-decoration: none; color: inherit;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s, transform 0.2s;
}
.msv__guide-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); text-decoration: none; }
/* Rotating accent colours on top border */
.msv__guide-card:nth-child(1)  { border-top-color: #1a3560; }
.msv__guide-card:nth-child(2)  { border-top-color: #2a7a5e; }
.msv__guide-card:nth-child(3)  { border-top-color: #be0011; }
.msv__guide-card:nth-child(4)  { border-top-color: #1a3560; }
.msv__guide-card:nth-child(5)  { border-top-color: #5b4fcf; }
.msv__guide-card:nth-child(6)  { border-top-color: #2a7a5e; }
.msv__guide-card:nth-child(7)  { border-top-color: #be0011; }
.msv__guide-card:nth-child(8)  { border-top-color: #1a3560; }
.msv__guide-card:nth-child(9)  { border-top-color: #2a7a5e; }
.msv__guide-card:nth-child(10) { border-top-color: #5b4fcf; }
.msv__guide-card:nth-child(11) { border-top-color: #1a3560; }
.msv__guide-card:nth-child(12) { border-top-color: #be0011; }
.msv__guide-icon { font-size: 1.6rem; line-height: 1; margin-bottom: 0.4rem; }
.msv__guide-title { font-size: 1rem; font-weight: 700; color: var(--navy); line-height: 1.35; }
.msv__guide-desc { font-size: 0.88rem; color: #5a6270; line-height: 1.6; flex: 1; margin-top: 0.1rem; }
.msv__guide-cta { font-size: 0.85rem; font-weight: 700; color: var(--navy); margin-top: 0.8rem; opacity: 0.75; }
.msv__guide-card:hover .msv__guide-cta { opacity: 1; }

/* ── UGE callout (in How It Works) ─────────────────────────────────── */
.msv__uge-callout {
  display: flex; align-items: flex-start; gap: 1rem;
  background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18);
  border-radius: 10px; padding: 1.25rem 1.4rem;
  margin: 0 0 2.2rem;
  color: #fff; font-size: 0.95rem; line-height: 1.6;
}
.msv__uge-callout-icon { font-size: 2rem; flex-shrink: 0; margin-top: 0.1rem; }
.msv__uge-callout strong { color: #fff; }
.msv__uge-callout em { color: rgba(255,255,255,0.7); font-style: normal; }

/* ── Consulate fallback note ────────────────────────────────────────── */
.msv__consulate-note {
  background: rgba(255,255,255,0.06); border-left: 3px solid rgba(255,255,255,0.25);
  border-radius: 0 8px 8px 0; padding: 1rem 1.2rem;
  margin: 2rem 0 0;
  font-size: 0.9rem; color: rgba(255,255,255,0.8); line-height: 1.6;
}
.msv__consulate-note strong { color: #fff; }

/* ── Final CTA section ────────────────────────────────────────────── */
.msv__final-cta {
  background: linear-gradient(135deg, var(--navy) 0%, #0f2540 50%, #0c1930 100%);
  padding: 5.5rem 0;
  text-align: center;
