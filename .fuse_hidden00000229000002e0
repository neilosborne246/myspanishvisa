<script>
const exchangeRates = {
  'EUR': 1.00,
  'GBP': 0.86,
  'USD': 1.08,
  'CAD': 1.48,
  'AUD': 1.65,
  'ZAR': 20.00,
  'CHF': 0.94
};

const taxBrackets = [
  { min: 0, max: 12450, rate: 0.19 },
  { min: 12450, max: 20200, rate: 0.24 },
  { min: 20200, max: 35200, rate: 0.30 },
  { min: 35200, max: 60000, rate: 0.37 },
  { min: 60000, max: 300000, rate: 0.45 },
  { min: 300000, max: Infinity, rate: 0.47 }
];

const taxToggle = document.getElementById('tax-beckham');
taxToggle.addEventListener('click', function() {
  const isActive = this.getAttribute('data-active') === 'true';
  this.setAttribute('data-active', !isActive);
  this.classList.toggle('active');
});

function formatCurrency(value, currency = 'EUR') {
  const symbols = { 'EUR': '€', 'GBP': '£', 'USD': '$', 'CAD': '$', 'AUD': '$', 'ZAR': 'R', 'CHF': 'Fr' };
  const symbol = symbols[currency] || currency;
  return symbol + ' ' + value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}

function calculateProgressiveTax(income) {
  let tax = 0;
  let taxBreakdown = [];
  for (let bracket of taxBrackets) {
    if (income <= bracket.min) break;
    const taxableInThisBracket = Math.min(income, bracket.max) - bracket.min;
    const taxInThisBracket = taxableInThisBracket * bracket.rate;
    tax += taxInThisBracket;
    taxBreakdown.push({
      min: bracket.min,
      max: bracket.max,
      rate: bracket.rate,
      taxable: taxableInThisBracket,
      tax: taxInThisBracket
    });
  }
  return { totalTax: tax, breakdown: taxBreakdown };
}

function calculateTax() {
  const incomeType = document.getElementById('tax-income-type').value;
  const currency = document.getElementById('tax-currency').value;
  const grossIncome = parseFloat(document.getElementById('tax-gross-income').value) || 0;
  const deductions = parseFloat(document.getElementById('tax-deductions').value) || 0;
  const personalSit = document.getElementById('tax-personal-situation').value;
  const dependants = parseInt(document.getElementById('tax-dependants').value) || 0;
  const useBeckham = taxToggle.getAttribute('data-active') === 'true';

  const exchangeRate = exchangeRates[currency];
  const grossIncomeEUR = grossIncome / exchangeRate;

  // Auto-calculate social security
  let ssContribution = 0;
  if (incomeType === 'self-employed' || incomeType === 'mixed') {
    ssContribution = grossIncomeEUR * 0.18;
  } else {
    ssContribution = grossIncomeEUR * 0.0635;
  }

  const taxableIncome = Math.max(0, grossIncomeEUR - deductions - ssContribution);

  // Apply Beckham Law if selected
  let totalTax = 0;
  let taxBreakdown = [];
  if (useBeckham) {
    totalTax = Math.min(taxableIncome, 600000) * 0.24;
  } else {
    const result = calculateProgressiveTax(taxableIncome);
    totalTax = result.totalTax;
    taxBreakdown = result.breakdown;
  }

  // Apply dependant deductions
  let dependantDeduction = dependants * 1500;
  totalTax = Math.max(0, totalTax - dependantDeduction);

  const totalDeductions = ssContribution + totalTax;
  const netIncome = grossIncomeEUR - totalDeductions;
  const effectiveRate = grossIncomeEUR > 0 ? (totalDeductions / grossIncomeEUR) * 100 : 0;

  const resultsDiv = document.getElementById('tax-results');
  resultsDiv.classList.add('show');

  document.getElementById('tax-taxable').textContent = formatCurrency(taxableIncome, 'EUR').replace(/€\s?/, '');
  document.getElementById('tax-total-tax').textContent = formatCurrency(totalTax, 'EUR').replace(/€\s?/, '');
  document.getElementById('tax-ss-amount').textContent = formatCurrency(ssContribution, 'EUR').replace(/€\s?/, '');
  document.getElementById('tax-effective-rate').textContent = effectiveRate.toFixed(1);
  document.getElementById('tax-net-annual').textContent = formatCurrency(netIncome, 'EUR').replace(/€\s?/, '');
  document.getElementById('tax-net-monthly').textContent = formatCurrency(netIncome / 12, 'EUR').replace(/€\s?/, '');
  document.getElementById('tax-rate-display').textContent = 'Effective Tax Rate: ' + effectiveRate.toFixed(1) + '%';

  // Tax bracket visualization
  if (!useBeckham && taxBreakdown.length > 0) {
    let bracketHTML = '<h4>Tax Breakdown by Bracket</h4>';
    bracketHTML += '<div class="tax-bracket-bar">';
    const colors = ['#ff4444', '#ff6b6b', '#ff8888', '#ffaa88', '#ffcc88', '#ffdd99'];
    taxBreakdown.forEach((bracket, idx) => {
      const percent = (bracket.tax / totalTax) * 100;
      bracketHTML += `<div class="tax-bracket-segment" style="flex: ${percent || 0.1}; background: ${colors[idx] || '#ff9999'};"></div>`;
    });
    bracketHTML += '</div><div class="tax-bracket-info">';
    taxBreakdown.forEach((bracket, idx) => {
      bracketHTML += `<div class="tax-bracket-info-item"><span class="tax-bracket-label">${bracket.rate * 100}% bracket:</span><span class="tax-bracket-amount">${formatCurrency(bracket.tax, 'EUR').replace(/€\s?/, '')}</span></div>`;
    });
    bracketHTML += '</div>';
    document.getElementById('tax-bracket-section').innerHTML = bracketHTML;
  } else if (useBeckham) {
    document.getElementById('tax-bracket-section').innerHTML = '<h4>Beckham Law (Flat 24% Rate)</h4><p style="font-size: 0.88rem; color: var(--muted);">Under the Beckham Law special tax regime, you pay a flat 24% rate on Spanish-source income instead of progressive brackets.</p>';
  }

  // Comparison section
  if (useBeckham && grossIncomeEUR > 20000) {
    const regularTaxResult = calculateProgressiveTax(taxableIncome);
    const regularTax = regularTaxResult.totalTax - dependantDeduction;
    const beckhamTax = totalTax;
    const savings = Math.max(0, regularTax - beckhamTax);

    let compHTML = '<div style="background: white; padding: 1.5rem; border-radius: 8px; margin-top: 1.5rem;">';
    compHTML += '<div class="comparison-tabs"><button class="comparison-tab active" onclick="switchTab(event, \'regular\')">Regular Taxation</button><button class="comparison-tab" onclick="switchTab(event, \'beckham\')">Beckham Law</button></div>';
    compHTML += '<div class="comparison-content show" id="tab-regular"><div class="tax-comparison-item"><span class="tax-comparison-label">Tax Liability:</span><span class="tax-comparison-value">' + formatCurrency(regularTax, 'EUR').replace(/€\s?/, '') + '</span></div></div>';
    compHTML += '<div class="comparison-content" id="tab-beckham"><div class="tax-comparison-item"><span class="tax-comparison-label">Tax Liability (24% flat):</span><span class="tax-comparison-value">' + formatCurrency(beckhamTax, 'EUR').replace(/€\s?/, '') + '</span></div></div>';
    compHTML += '<div style="margin-top: 1rem; padding: 1rem; background: #f0f7ff; border-left: 3px solid var(--red); border-radius: 6px;"><p style="font-size: 0.88rem; color: var(--navy); margin: 0;"><strong>Beckham Law Savings:</strong> ' + formatCurrency(savings, 'EUR').replace(/€\s?/, '') + ' per year</p></div>';
    compHTML += '</div>';
    document.getElementById('tax-comparison-section').innerHTML = compHTML;
  } else {
    document.getElementById('tax-comparison-section').innerHTML = '';
  }

  window.scrollTo({ top: resultsDiv.offsetTop - 100, behavior: 'smooth' });
}

function switchTab(e, tabName) {
  e.preventDefault();
  document.querySelectorAll('.comparison-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.comparison-content').forEach(c => c.classList.remove('show'));
  e.target.classList.add('active');
  document.getElementById('tab-' + tabName).classList.add('show');
}

document.addEventListener('keypress', function(e) {
  if (e.key === 'Enter' && document.activeElement.id === 'tax-gross-income') {
    calculateTax();
  }
});
</script>

