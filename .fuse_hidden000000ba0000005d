    .btn-cta-primary:hover { box-shadow: 0 6px 20px rgba(190,0,17,0.55); transform: translateY(-2px); color: var(--white); }
    .btn-cta-ghost {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: transparent; color: var(--white); font-family: var(--font); font-size: 0.95rem; font-weight: 700;
      padding: 0.9rem 2.2rem; border-radius: 6px; border: 2px solid rgba(255,255,255,0.3); text-decoration: none;
      transition: border-color 0.15s, background 0.15s;
    }
    .btn-cta-ghost:hover { border-color: var(--yellow); background: rgba(255,255,255,0.06); color: var(--white); }

    /* ── Footer (simplified inline) ──────────────────────────────────── */
    .site-footer {
      background: var(--navy); color: rgba(255,255,255,0.6);
      font-size: 0.82rem; text-align: center; padding: 1.5rem 2rem;
