  <style>
    /* ── Reset & Tokens ──────────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --navy: #0c1930;
      --navy-mid: #1a3a5c;
      --red: #be0011;
      --red-deep: #8c000d;
      --yellow: #facf39;
      --cream: #f8f7f4;
      --white: #ffffff;
      --muted: #5a6478;
      --border: #dce3ed;
      --font: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
    }
    html, body { max-width: 100%; overflow-x: clip; font-family: var(--font); color: var(--navy); background: var(--white); }

    /* ── Utility ─────────────────────────────────────────────────────── */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 2rem; }
    .container--narrow { max-width: 860px; margin: 0 auto; padding: 0 2rem; }
    .stars { color: var(--yellow); font-size: 1.1rem; letter-spacing: 0.05em; }
    .badge {
      display: inline-block;
      background: rgba(250,207,57,0.15);
      color: #7a5c00;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.09em;
      padding: 0.3rem 0.8rem;
      border-radius: 4px;
    }
    .btn-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
      color: var(--white); font-family: var(--font); font-size: 0.95rem; font-weight: 700;
      padding: 0.85rem 2rem; border-radius: 6px; text-decoration: none;
      box-shadow: 0 4px 14px rgba(190,0,17,0.35); transition: box-shadow 0.15s, transform 0.15s;
    }
    .btn-primary:hover { box-shadow: 0 6px 20px rgba(190,0,17,0.5); transform: translateY(-2px); color: var(--white); }
    .btn-secondary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: transparent; color: var(--navy); font-family: var(--font); font-size: 0.95rem; font-weight: 700;
      padding: 0.85rem 2rem; border-radius: 6px; border: 2px solid var(--navy); text-decoration: none;
      transition: background 0.15s, color 0.15s;
    }
    .btn-secondary:hover { background: var(--navy); color: var(--white); }
    .section-label {
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--red); margin-bottom: 0.75rem;
    }

    /* ── Breadcrumb ──────────────────────────────────────────────────── */
    .breadcrumb {
      background: var(--cream); border-bottom: 1px solid var(--border);
      padding: 0.75rem 0; font-size: 0.82rem; color: var(--muted);
    }
    .breadcrumb a { color: var(--muted); text-decoration: none; }
    .breadcrumb a:hover { color: var(--red); }
    .breadcrumb span { margin: 0 0.4rem; }

    /* ── Hero ────────────────────────────────────────────────────────── */
    .hero {
      background: linear-gradient(135deg, var(--navy) 0%, #0d2240 60%, #0a1d38 100%);
      padding: 5rem 0 4rem;
      text-align: center;
      border-bottom: 4px solid var(--yellow);
    }
    .hero__label {
      display: inline-block;
      font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;
      color: var(--yellow); margin-bottom: 1.25rem;
    }
    .hero h1 {
      font-size: clamp(1.8rem, 4vw, 2.8rem);
      font-weight: 800; color: var(--white); line-height: 1.2; margin-bottom: 1.25rem;
    }
    .hero__sub {
      font-size: 1.1rem; color: rgba(255,255,255,0.72); margin-bottom: 2.5rem; line-height: 1.7;
      max-width: 620px; margin-left: auto; margin-right: auto;
    }
    .hero__rating {
      display: flex; align-items: center; justify-content: center; gap: 1rem;
      flex-wrap: wrap; margin-bottom: 2rem;
    }
    .hero__rating-score {
      font-size: 2.8rem; font-weight: 800; color: var(--white); line-height: 1;
    }
    .hero__rating-detail { text-align: left; }
    .hero__rating-detail .stars { font-size: 1.3rem; }
    .hero__rating-detail p { font-size: 0.85rem; color: rgba(255,255,255,0.6); margin-top: 0.2rem; }
    .hero__trust-badge {
      display: inline-flex; align-items: center; gap: 0.6rem;
      background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);
      border-radius: 50px; padding: 0.5rem 1.25rem;
      font-size: 0.82rem; color: rgba(255,255,255,0.75); font-weight: 600;
    }
    .hero__trust-badge .dot { width: 8px; height: 8px; background: #4ade80; border-radius: 50%; display: inline-block; }

    /* ── Stats Bar ───────────────────────────────────────────────────── */
    .stats-bar {
      background: var(--navy);
      padding: 1.5rem 0;
    }
    .stats-bar__inner {
      display: flex; justify-content: center; align-items: center;
      gap: 0; flex-wrap: wrap;
    }
    .stats-bar__item {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0.5rem 2rem; border-right: 1px solid rgba(255,255,255,0.12);
      text-align: center;
    }
    .stats-bar__item:last-child { border-right: none; }
    .stats-bar__num { font-size: 1.5rem; font-weight: 800; color: var(--yellow); line-height: 1; }
    .stats-bar__label { font-size: 0.78rem; color: rgba(255,255,255,0.6); font-weight: 500; }
    @media (max-width: 700px) {
      .stats-bar__item { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); width: 50%; padding: 1rem; }
    }

    /* ── Testimonials Grid ───────────────────────────────────────────── */
    .testimonials-section { background: var(--cream); padding: 5rem 0; }
    .testimonials-section h2 {
      font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: var(--navy);
      text-align: center; margin-bottom: 0.75rem;
    }
    .testimonials-section .sub {
      text-align: center; color: var(--muted); font-size: 1rem; margin-bottom: 3.5rem; line-height: 1.6;
    }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.5rem;
    }
    .testimonial-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.75rem;
      display: flex; flex-direction: column; gap: 1rem;
      position: relative;
    }
    .testimonial-card::before {
      content: '\201C';
      position: absolute; top: 1.25rem; right: 1.5rem;
      font-size: 3.5rem; line-height: 1; color: var(--border);
      font-family: Georgia, serif;
    }
    .testimonial-card__header { display: flex; align-items: center; gap: 1rem; }
    .testimonial-card__avatar {
      width: 48px; height: 48px; border-radius: 50%;
      background: var(--navy); display: flex; align-items: center; justify-content: center;
      font-size: 1rem; font-weight: 700; color: var(--yellow); flex-shrink: 0;
    }
    .testimonial-card__meta h3 { font-size: 0.95rem; font-weight: 700; color: var(--navy); margin-bottom: 0.1rem; }
    .testimonial-card__meta p { font-size: 0.78rem; color: var(--muted); }
    .testimonial-card__stars { display: flex; gap: 0.15rem; }
    .testimonial-card__star { color: var(--yellow); font-size: 0.9rem; }
    .testimonial-card__body { font-size: 0.92rem; line-height: 1.75; color: #3a4255; }
    .testimonial-card__footer {
      display: flex; align-items: center; justify-content: space-between;
      padding-top: 1rem; border-top: 1px solid var(--border);
    }
    .testimonial-card__visa-badge {
      display: inline-block; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.07em; padding: 0.25rem 0.65rem; border-radius: 4px;
    }
    .testimonial-card__visa-badge--nlv { background: rgba(12,25,48,0.07); color: var(--navy); }
    .testimonial-card__visa-badge--dnv { background: rgba(190,0,17,0.08); color: var(--red-deep); }
    .testimonial-card__visa-badge--student { background: rgba(250,207,57,0.2); color: #7a5c00; }
    .testimonial-card__visa-badge--post { background: rgba(0,140,80,0.1); color: #005c35; }
    .testimonial-card__date { font-size: 0.75rem; color: var(--muted); }

    /* ── Visa type filter tabs ───────────────────────────────────────── */
    .filter-tabs {
      display: flex; gap: 0.5rem; flex-wrap: wrap; justify-content: center;
      margin-bottom: 2.5rem;
    }
    .filter-tab {
      display: inline-block; padding: 0.45rem 1.2rem;
      border: 1.5px solid var(--border); border-radius: 50px;
      font-size: 0.82rem; font-weight: 600; color: var(--muted);
      background: var(--white); cursor: pointer; text-decoration: none;
      transition: border-color 0.15s, color 0.15s, background 0.15s;
    }
    .filter-tab:hover, .filter-tab.active {
      border-color: var(--navy); color: var(--navy); background: rgba(12,25,48,0.04);
    }

    /* ── Trust Signals Section ───────────────────────────────────────── */
    .trust-section { padding: 5rem 0; background: var(--white); }
    .trust-section h2 {
      font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; color: var(--navy);
      text-align: center; margin-bottom: 0.75rem;
    }
    .trust-section .sub { text-align: center; color: var(--muted); font-size: 1rem; margin-bottom: 3.5rem; }
    .trust-pillars {
      display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2rem;
    }
    .trust-pillar {
      background: var(--cream); border: 1px solid var(--border); border-radius: 12px;
      padding: 2rem 1.75rem;
    }
    .trust-pillar__icon {
      width: 52px; height: 52px; border-radius: 10px;
      background: var(--navy); display: flex; align-items: center; justify-content: center;
      margin-bottom: 1.25rem;
    }
    .trust-pillar__icon svg { width: 26px; height: 26px; fill: var(--yellow); }
    .trust-pillar h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.75rem; }
    .trust-pillar p { font-size: 0.88rem; line-height: 1.7; color: var(--muted); }

    /* ── Press / Logos section ───────────────────────────────────────── */
    .press-section { background: var(--cream); padding: 3.5rem 0; }
    .press-section h2 { font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); text-align: center; margin-bottom: 2rem; }
    .press-logos {
      display: flex; align-items: center; justify-content: center;
      gap: 3rem; flex-wrap: wrap;
    }
    .press-logo-placeholder {
      width: 120px; height: 36px; background: var(--border); border-radius: 6px;
      display: flex; align-items: center; justify-content: center;
      font-size: 0.7rem; color: var(--muted); font-weight: 600; letter-spacing: 0.05em;
    }

    /* ── FAQ Section ─────────────────────────────────────────────────── */
    .faq-section { padding: 5rem 0; background: var(--white); }
    .faq-section h2 {
      font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 800; color: var(--navy);
      text-align: center; margin-bottom: 0.75rem;
    }
    .faq-section .sub { text-align: center; color: var(--muted); font-size: 1rem; margin-bottom: 3rem; }
    .faq-list { display: flex; flex-direction: column; gap: 0; }
    .faq-item {
      border-bottom: 1px solid var(--border); overflow: hidden;
    }
    .faq-item:first-child { border-top: 1px solid var(--border); }
    .faq-question {
      display: flex; justify-content: space-between; align-items: center;
      padding: 1.25rem 0; cursor: pointer; gap: 1rem;
    }
    .faq-question h3 { font-size: 0.97rem; font-weight: 700; color: var(--navy); }
    .faq-toggle {
      width: 28px; height: 28px; flex-shrink: 0; border-radius: 50%;
      background: var(--cream); border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-size: 1rem; color: var(--navy); font-weight: 700;
      transition: background 0.15s, color 0.15s;
    }
    .faq-item.open .faq-toggle { background: var(--navy); color: var(--white); }
    .faq-answer {
      display: none; padding: 0 0 1.25rem;
      font-size: 0.9rem; line-height: 1.8; color: var(--muted);
    }
    .faq-item.open .faq-answer { display: block; }

    /* ── CTA Section ─────────────────────────────────────────────────── */
    .cta-section {
      background: linear-gradient(135deg, var(--navy) 0%, #0d2240 60%, #0a1d38 100%);
      padding: 5rem 0; text-align: center; border-top: 4px solid var(--yellow);
    }
    .cta-section h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 800; color: var(--white); margin-bottom: 1rem; }
    .cta-section p { font-size: 1.05rem; color: rgba(255,255,255,0.7); margin-bottom: 2.5rem; max-width: 560px; margin-left: auto; margin-right: auto; line-height: 1.7; }
    .cta-btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
    .btn-cta-primary {
      display: inline-flex; align-items: center; gap: 0.5rem;
      background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
      color: var(--white); font-family: var(--font); font-size: 0.95rem; font-weight: 700;
      padding: 0.9rem 2.2rem; border-radius: 6px; text-decoration: none;
