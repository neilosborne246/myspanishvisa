<script>
const exchangeRates = {
  EUR: 1.00,
  GBP: 1.17,
  USD: 0.92,
  AUD: 0.61,
  CAD: 0.68,
  ZAR: 0.05
};

const currencySymbols = {
  EUR: '€',
  GBP: '£',
  USD: '$',
  AUD: 'A$',
  CAD: 'C$',
  ZAR: 'R'
};

const IPREM_2026 = 600; // €600 per month
const SINGLE_APPLICANT_PERCENTAGE = 4.0; // 400% IPREM
const ADDITIONAL_MEMBER_PERCENTAGE = 1.0; // 100% IPREM per member

document.getElementById('currency').addEventListener('change', function() {
  const rate = exchangeRates[this.value];
  document.getElementById('exchangeRate').value = rate.toFixed(2);
});

function formatCurrency(value, currency) {
  const symbol = currencySymbols[currency] || currency;
  return symbol + value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function calculateIncome() {
  // Get input values
  const numApplicants = parseInt(document.getElementById('numApplicants').value) || 1;
  const currency = document.getElementById('currency').value;
  const exchangeRate = parseFloat(document.getElementById('exchangeRate').value) || 1;
  const pensionIncome = parseFloat(document.getElementById('pensionIncome').value) || 0;
  const rentalIncome = parseFloat(document.getElementById('rentalIncome').value) || 0;
  const investmentIncome = parseFloat(document.getElementById('investmentIncome').value) || 0;
  const otherIncome = parseFloat(document.getElementById('otherIncome').value) || 0;
  const savings = parseFloat(document.getElementById('savings').value) || 0;

  // Convert all inputs to EUR
  const pensionIncomeEur = pensionIncome * exchangeRate;
  const rentalIncomeEur = rentalIncome * exchangeRate;
  const investmentIncomeEur = investmentIncome * exchangeRate;
  const otherIncomeEur = otherIncome * exchangeRate;
  const savingsEur = savings * exchangeRate;

  // Calculate required monthly income
  const requiredMonthlyEur = (SINGLE_APPLICANT_PERCENTAGE * IPREM_2026) + ((numApplicants - 1) * ADDITIONAL_MEMBER_PERCENTAGE * IPREM_2026);
  const requiredAnnualEur = requiredMonthlyEur * 12;

  // Calculate total monthly income
  const totalMonthlyIncomeEur = pensionIncomeEur + rentalIncomeEur + investmentIncomeEur + otherIncomeEur;
  const totalAnnualIncomeEur = totalMonthlyIncomeEur * 12;

  // Calculate gap
  const monthlyGapEur = Math.max(0, requiredMonthlyEur - totalMonthlyIncomeEur);
  const annualGapEur = monthlyGapEur * 12;

  // Savings assessment
  const requiredSavingsEur = requiredAnnualEur;
  const savingsGapEur = Math.max(0, requiredSavingsEur - savingsEur);

  // Determine eligibility
  let eligible = false;
  let eligibilityStatus = 'red';
  let eligibilityMessage = '';

  if (totalAnnualIncomeEur >= requiredAnnualEur) {
    eligible = true;
    eligibilityStatus = 'green';
    eligibilityMessage = 'ELIGIBLE: Your income exceeds requirements.';
  } else if (totalAnnualIncomeEur + savingsEur >= requiredAnnualEur * 1.5) {
    // Savings can cover gap plus buffer
    eligible = true;
    eligibilityStatus = 'green';
    eligibilityMessage = 'ELIGIBLE: Income + savings meet requirements.';
  } else if (totalAnnualIncomeEur + savingsEur >= requiredAnnualEur) {
    eligible = true;
    eligibilityStatus = 'green';
    eligibilityMessage = 'ELIGIBLE: Income + savings meet minimum threshold.';
  } else if (monthlyGapEur < requiredMonthlyEur * 0.25 && savingsEur > 0) {
    // Small gap with some savings
    eligible = false;
    eligibilityStatus = 'warn';
    eligibilityMessage = 'AT RISK: Small gap but may be manageable with more documentation.';
  } else {
    eligible = false;
    eligibilityStatus = 'error';
    eligibilityMessage = 'NOT ELIGIBLE: Significant gap between income/savings and requirements.';
  }

  // Build results HTML
  const resultsBox = document.getElementById('resultsBox');
  resultsBox.className = `msv__calc-results ${eligibilityStatus}`;

  let resultsHTML = `
    <div class="msv__result-row">
      <span class="msv__result-label">Required Monthly Income (${numApplicants} applicant${numApplicants > 1 ? 's' : ''})</span>
      <span class="msv__result-value">${formatCurrency(requiredMonthlyEur, 'EUR')}</span>
    </div>
    <div class="msv__result-row">
      <span class="msv__result-label">Your Total Monthly Income</span>
      <span class="msv__result-value">${formatCurrency(totalMonthlyIncomeEur, 'EUR')}</span>
    </div>
  `;

  if (monthlyGapEur > 0) {
    resultsHTML += `
      <div class="msv__result-row">
        <span class="msv__result-label">Monthly Income Gap</span>
        <span class="msv__result-value" style="color: #ef4444;">-${formatCurrency(monthlyGapEur, 'EUR')}</span>
      </div>
      <div class="msv__result-row">
        <span class="msv__result-label">Annual Income Gap</span>
        <span class="msv__result-value" style="color: #ef4444;">-${formatCurrency(annualGapEur, 'EUR')}</span>
      </div>
    `;
  }

  resultsHTML += `
    <div class="msv__result-row">
      <span class="msv__result-label">Your Total Liquid Savings</span>
      <span class="msv__result-value">${formatCurrency(savingsEur, 'EUR')}</span>
    </div>
    <div class="msv__result-row">
      <span class="msv__result-label">Required Savings Threshold (12 months)</span>
      <span class="msv__result-value">${formatCurrency(requiredSavingsEur, 'EUR')}</span>
    </div>
  `;

  if (savingsGapEur > 0) {
    resultsHTML += `
      <div class="msv__result-row">
        <span class="msv__result-label">Savings Shortfall</span>
        <span class="msv__result-value" style="color: #ef4444;">-${formatCurrency(savingsGapEur, 'EUR')}</span>
      </div>
    `;
  }

  resultsHTML += `
    <div class="msv__calc-summary">
      <h4>${eligibilityMessage}</h4>
      <p>${getEligibilityDetails(eligible, totalAnnualIncomeEur, requiredAnnualEur, savingsEur, requiredSavingsEur, numApplicants)}</p>
    </div>
  `;

  resultsBox.innerHTML = resultsHTML;
  document.getElementById('results').style.display = 'block';
  resultsBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function getEligibilityDetails(eligible, actualIncome, requiredIncome, actualSavings, requiredSavings, numApplicants) {
  if (eligible && actualIncome >= requiredIncome) {
    return `Your passive income of €${actualIncome.toFixed(0)} exceeds the requirement of €${requiredIncome.toFixed(0)} for ${numApplicants} applicant${numApplicants > 1 ? 's' : ''}. You meet the NLV financial requirement with an income buffer.`;
  } else if (eligible && actualIncome + actualSavings >= requiredIncome) {
    const gap = requiredIncome - actualIncome;
    return `Your passive income (€${actualIncome.toFixed(0)}) covers most of the requirement. Your savings of €${actualSavings.toFixed(0)} can cover the remaining gap of €${gap.toFixed(0)}, making you eligible overall. Ensure you can document both income and savings sources thoroughly.`;
  } else {
    const gap = requiredIncome - actualIncome - actualSavings;
    return `You have a shortfall of approximately €${gap.toFixed(0)} annually. Consider building additional savings, generating passive income through rental or investment sources, or reassessing your family composition. Document all current income sources carefully for your application.`;
  }
}
</script>

