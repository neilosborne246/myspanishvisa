/* ── Brand tokens (root-level so all fragments inherit) ── */
:root {
  --navy:      #0c1930;
  --navy-mid:  #1a3a5c;
  --red:       #be0011;
  --red-deep:  #8c000d;
  --yellow:    #facf39;
  --cream:     #f8f7f4;
  --white:     #ffffff;
  --black:     #1a1a1a;
  --muted:     #5a6478;
  --border:    #dce3ed;
