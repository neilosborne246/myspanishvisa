.msv__faq-list details[open] summary::after { transform: rotate(45deg); }
.msv__faq-list details[open] summary { color: var(--red); }
.msv__faq-answer { padding: 0 1.5rem 1.3rem; font-size: 0.92rem; color: var(--muted); line-height: 1.75; }
.msv__faq-answer p { color: var(--muted); font-size: 0.92rem; margin-bottom: 0.75rem; }
.msv__faq-answer p:last-child { margin-bottom: 0; }

/* ── CTA band ────────────────────────────────────────────────── */
.msv__cta-band { background: linear-gradient(135deg, var(--navy) 0%, #0d2240 60%, #0a1d38 100%); padding: 5rem 0; text-align: center; }
.msv__cta-band h2 { color: var(--white) !important; display: block; }
.msv__cta-band h2::after { left: 50%; transform: translateX(-50%); background: linear-gradient(90deg, var(--yellow), #e8b820); }
