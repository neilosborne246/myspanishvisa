.pls-header, .pls-body, .pls-nlv, .pls-dnv, .pls-student {
  max-width: 100%;
  overflow-x: clip;
  position: relative;
}
/* Cap all media inside the wrapper */
.msv img, .msv video, .msv iframe,
.msv-footer img, .msv-footer video, .msv-footer iframe {
  max-width: 100%;
  height: auto;
}
/* Never use 100vw — use 100% instead (dev reminder) */


/* ── Reset & scope ─────────────────────────────────────────────────── */
.msv *, .msv *::before, .msv *::after { box-sizing: border-box; margin: 0; padding: 0; }

/* ── Tokens ──────────────────────────────────────────────────────── */
.msv {
  --navy: #0c1930; --navy-mid: #1a3a5c; --red: #be0011; --red-deep: #8c000d;
  --yellow: #facf39; --cream: #f8f7f4; --white: #ffffff; --black: #1a1a1a;
  --muted: #5a6478; --border: #dce3ed;
  --shadow-sm: 0 2px 8px rgba(12,25,48,0.08); --shadow-md: 0 6px 24px rgba(12,25,48,0.13);
  font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
  font-size: 16px; line-height: 1.75; color: var(--black); width: 100%;
}
.msv__container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
.msv__container--narrow { max-width: 780px; margin: 0 auto; padding: 0 2rem; }
@media (max-width: 640px) { .msv__container, .msv__container--narrow { padding: 0 1.2rem; } }

/* ── Typography ──────────────────────────────────────────────────── */
.msv h1 { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.12; color: var(--white); letter-spacing: -0.025em; margin-bottom: 1.2rem; }
.msv h2 { font-size: clamp(1.3rem, 2.5vw, 1.75rem); font-weight: 700; color: var(--navy); letter-spacing: -0.01em; margin-bottom: 0.5rem; position: relative; display: inline-block; padding-bottom: 0.5rem; }
.msv h2::after { content: ''; position: absolute; bottom: 0; left: 0; width: 44px; height: 3px; background: linear-gradient(90deg, var(--red), var(--red-deep)); border-radius: 2px; }
.msv h3 { font-size: 1.05rem; font-weight: 700; color: var(--navy); margin-bottom: 0.4rem; }
.msv p { color: var(--black); margin-bottom: 1rem; font-size: 0.97rem; }
.msv a { color: var(--red); text-decoration: none; }
.msv a:hover { text-decoration: underline; }
.msv ul { list-style: none; padding: 0; margin: 0 0 1rem; }
.msv ul li { padding: 0.35rem 0 0.35rem 1.4rem; position: relative; font-size: 0.95rem; color: var(--black); }
.msv ul li::before { content: ''; position: absolute; left: 0; top: 0.75rem; width: 7px; height: 7px; background: linear-gradient(135deg, var(--red), var(--red-deep)); border-radius: 50%; }

/* ── Sections ─────────────────────────────────────────────────── */
.msv__section { padding: 5rem 0; background: var(--white); }
.msv__section--cream { padding: 5rem 0; background: linear-gradient(180deg, #f8f7f4 0%, #f2f4f8 100%); }
.msv__section--dark { padding: 5rem 0; background: linear-gradient(135deg, var(--navy) 0%, #0d2240 55%, #0a1d38 100%); }
.msv__section--dark h2 { color: var(--white) !important; }
.msv__section--dark h2::after { background: linear-gradient(90deg, var(--yellow), #e8b820); }
.msv__section--dark h3 { color: rgba(255,255,255,0.9) !important; }
.msv .msv__section--dark p, .msv .msv__section--dark li { color: rgba(255,255,255,0.82); }
.msv__section--dark ul li::before { background: linear-gradient(135deg, var(--yellow), #e8b820); }
@media (max-width: 640px) { .msv__section, .msv__section--cream, .msv__section--dark { padding: 3.5rem 0; } }
.msv__section-hd { margin-bottom: 3rem; }
.msv__section-hd p { color: var(--muted); font-size: 1rem; margin-top: 0.75rem; line-height: 1.7; max-width: 600px; }

/* ── Animations ──────────────────────────────────────────────────── */
@keyframes msv-fade-up { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: translateY(0); } }
@keyframes msv-shimmer {
  0%   { background-position: -400px 0; }
  100% { background-position: 400px 0; }
}
.msv__shimmer {
  background: linear-gradient(90deg, var(--yellow) 0%, #e8b820 25%, var(--red) 50%, #e8b820 75%, var(--yellow) 100%);
  background-size: 400px 100%;
  -webkit-background-clip: text; background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: msv-shimmer 3.5s linear infinite;
  display: inline;
}

/* ── Hero ─────────────────────────────────────────────────────── */
.msv__hero { background: linear-gradient(135deg, #0c1930 0%, #0f2540 40%, #162d50 70%, #1a3560 100%); padding: 5.5rem 0 5rem; position: relative; overflow: hidden; }
.msv__hero::before { content: ''; position: absolute; top: -30%; right: -5%; width: 700px; height: 700px; background: radial-gradient(circle, rgba(190,0,17,0.1) 0%, transparent 65%); pointer-events: none; }
.msv__hero::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, transparent, rgba(250,207,57,0.4), transparent); }
.msv__hero-inner { max-width: 780px; animation: msv-fade-up 0.7s ease-out both; }
.msv__eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(190,0,17,0.15); border: 1px solid rgba(190,0,17,0.4); color: #ff6b7a; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 0.35rem 0.9rem; border-radius: 100px; margin-bottom: 1.5rem; }
.msv__eyebrow::before { content: ''; width: 6px; height: 6px; background: var(--red); border-radius: 50%; box-shadow: 0 0 6px var(--red); }
.msv__hero p { color: rgba(255,255,255,0.78) !important; font-size: clamp(1rem, 2.2vw, 1.15rem); max-width: 640px; margin-bottom: 2.2rem; line-height: 1.75; }

/* ── Breadcrumb ───────────────────────────────────────────────── */
.msv__breadcrumb { padding: 0.85rem 0; border-bottom: 1px solid var(--border); background: var(--white); }
.msv__breadcrumb-inner { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--muted); flex-wrap: wrap; }
.msv__breadcrumb-inner a { color: var(--red); text-decoration: none; }
.msv__breadcrumb-inner a:hover { text-decoration: underline; }
.msv__breadcrumb-inner span { color: var(--muted); }

/* ── Buttons ─────────────────────────────────────────────────── */
.msv__btn-group { display: flex; flex-wrap: wrap; gap: 0.85rem; }
.msv__btn { display: inline-block; padding: 0.85rem 2rem; font-size: 0.92rem; font-weight: 700; border-radius: 6px; text-decoration: none !important; transition: transform 0.15s, box-shadow 0.15s; }
.msv__btn:hover { transform: translateY(-1px); text-decoration: none !important; }
.msv .msv__btn--primary { background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%); color: #ffffff !important; box-shadow: 0 4px 16px rgba(190,0,17,0.38); }
.msv .msv__btn--primary:hover { box-shadow: 0 6px 22px rgba(190,0,17,0.48); color: #ffffff !important; }
.msv .msv__btn--outline-white { background: transparent; color: #ffffff !important; border: 1.5px solid rgba(255,255,255,0.5); }
.msv .msv__btn--outline-white:hover { background: rgba(255,255,255,0.1); color: #ffffff !important; }

/* ── Trust bar ──────────────────────────────────────────────── */
.msv__trust-bar { background: var(--white); border-bottom: 1px solid var(--border); padding: 1rem 0; box-shadow: var(--shadow-sm); }
.msv__trust-bar-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.75rem; }
.msv__trust-item { display: flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; font-weight: 600; color: var(--navy); white-space: nowrap; }
.msv__trust-item::before { content: ''; width: 7px; height: 7px; background: linear-gradient(135deg, var(--red), var(--red-deep)); border-radius: 50%; flex-shrink: 0; }

/* ── Key facts strip ─────────────────────────────────────────── */
.msv__facts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; margin-bottom: 3rem; }
@media (max-width: 760px) { .msv__facts { grid-template-columns: 1fr 1fr; } }
@media (max-width: 420px) { .msv__facts { grid-template-columns: 1fr; } }
.msv__fact { background: var(--white); padding: 1.5rem 1.3rem; text-align: center; }
.msv__fact-icon { font-size: 1.5rem; display: block; margin-bottom: 0.5rem; }
.msv__fact-label { font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); display: block; margin-bottom: 0.25rem; }
.msv__fact-value { font-size: 0.97rem; font-weight: 700; color: var(--navy); line-height: 1.35; display: block; }

/* ── Route cards ─────────────────────────────────────────────── */
.msv__route-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1.5rem; }
@media (max-width: 640px) { .msv__route-grid { grid-template-columns: 1fr; } }
.msv__route-card { border-radius: 14px; border: 1px solid var(--border); padding: 1.8rem 1.6rem; background: var(--white); box-shadow: var(--shadow-sm); position: relative; overflow: hidden; }
.msv__route-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; }
.msv__route-card--public::before { background: linear-gradient(90deg, #0066cc, #3399ff); }
.msv__route-card--private::before { background: linear-gradient(90deg, #e67e22, #f39c12); }
.msv__route-tag { display: inline-block; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.25rem 0.75rem; border-radius: 100px; margin-bottom: 1rem; }
.msv__route-card--public .msv__route-tag { background: #dbeafe; color: #0044cc; }
.msv__route-card--private .msv__route-tag { background: #fef3e2; color: #92400e; }
.msv__route-card h3 { font-size: 1.05rem; font-weight: 800; color: var(--navy); margin-bottom: 0.6rem; }
.msv__route-card p { font-size: 0.9rem; color: var(--muted); margin: 0 0 0.5rem; line-height: 1.6; }

/* ── Step blocks ─────────────────────────────────────────────── */
.msv__steps { display: flex; flex-direction: column; gap: 1.5rem; }
.msv__step { display: flex; gap: 1.5rem; align-items: flex-start; }
.msv__step-num { width: 44px; height: 44px; flex-shrink: 0; border-radius: 50%; background: linear-gradient(135deg, var(--red), var(--red-deep)); color: #fff; font-size: 0.9rem; font-weight: 800; display: flex; align-items: center; justify-content: center; margin-top: 0.1rem; }
.msv__step-body h3 { font-size: 1rem; font-weight: 700; color: var(--navy); margin-bottom: 0.3rem; }
.msv__step-body p { font-size: 0.9rem; color: var(--muted); margin: 0; line-height: 1.65; }

/* ── City card grid ──────────────────────────────────────────── */
.msv__city-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; }
@media (max-width: 900px) { .msv__city-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 640px) { .msv__city-grid { grid-template-columns: 1fr 1fr; } }
@media (max-width: 420px) { .msv__city-grid { grid-template-columns: 1fr; } }
.msv__city-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 1.2rem; text-align: center; box-shadow: var(--shadow-sm); transition: box-shadow 0.2s, transform 0.2s; }
.msv__city-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); }
.msv__city-card h3 { font-size: 0.95rem; font-weight: 800; color: var(--navy); margin-bottom: 0.4rem; }
.msv__city-card p { font-size: 0.8rem; color: var(--muted); margin: 0; line-height: 1.5; }

/* ── Alert box ───────────────────────────────────────────────── */
.msv__alert { border-radius: 10px; padding: 1.3rem 1.5rem; display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 2rem; }
.msv__alert--warn { background: #fffbea; border: 1px solid #f0d060; }
.msv__alert--info { background: #eef4ff; border: 1px solid #a0bfff; }
.msv__alert--red { background: #fef2f2; border: 1px solid #fca5a5; }
.msv__alert-icon { font-size: 1.4rem; flex-shrink: 0; margin-top: 0.1rem; }
.msv__alert p { font-size: 0.9rem; color: var(--black); margin: 0; line-height: 1.65; }
.msv__alert strong { color: var(--navy); }

/* ── FAQs ────────────────────────────────────────────────────── */
.msv__faq-list { display: flex; flex-direction: column; gap: 0; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
.msv__faq-list details { border-bottom: 1px solid var(--border); background: var(--white); }
.msv__faq-list details:last-child { border-bottom: none; }
.msv__faq-list summary { padding: 1.2rem 1.5rem; font-size: 0.97rem; font-weight: 700; color: var(--navy); cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
