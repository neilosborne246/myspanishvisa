                    <div class="msv__step-num">4</div>
                    <div class="msv__step-body">
                        <h3>Select Appointment Date</h3>
                        <p>Choose an available date and time. Slots typically fill 2–4 weeks in advance during peak season (spring–summer).</p>
                    </div>
                </div>
