  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 1.1rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--navy);
  text-decoration: none;
  transition: background 0.12s;
}
.msv-nav__dropdown a:hover {
  background: var(--cream);
  color: var(--red);
}
.msv-nav__dropdown-icon {
  width: 24px;
  height: 24px;
  background: var(--cream);
  border-radius: 5px;
