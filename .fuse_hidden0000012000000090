  background: var(--red);
  color: #fff !important;
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: 6px;
  text-decoration: none;
  transition: background 0.15s, box-shadow 0.15s;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(190,0,17,0.3);
}
.msv-nav__cta:hover {
  background: var(--red-deep);
  box-shadow: 0 4px 14px rgba(190,0,17,0.4);
  text-decoration: none;
}

