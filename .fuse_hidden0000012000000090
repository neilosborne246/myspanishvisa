html, body { max-width: 100%; overflow-x: clip; }
/* Scoped wrapper safety */
.msv, .msv-nav, .msv-topbar, .msv-footer, .msv-footer-cta,
.pls-header, .pls-body, .pls-nlv, .pls-dnv, .pls-student {
  max-width: 100%;
  overflow-x: clip;
  position: relative;
}
/* Cap all media inside the wrapper */
.msv img, .msv video, .msv iframe,
.msv-footer img, .msv-footer video, .msv-footer iframe {
  max-width: 100%;
  height: auto;
}
/* Never use 100vw — use 100% instead (dev reminder) */


/* ── Reset & scope ─────────────────────────────────────────────────── */
.msv *, .msv *::before, .msv *::after {
  box-sizing: border-box; margin: 0; padding: 0;
}

/* ── Tokens ──────────────────────────────────────────────────────── */
.msv {
  --navy:       #0c1930;
  --navy-mid:   #1a3a5c;
  --red:        #be0011;
  --red-deep:   #8c000d;
  --yellow:     #facf39;
  --cream:      #f8f7f4;
  --white:      #ffffff;
  --black:      #1a1a1a;
  --muted:      #5a6478;
  --border:     #dce3ed;
  --shadow-sm:  0 2px 8px rgba(12,25,48,0.08);
  --shadow-md:  0 6px 24px rgba(12,25,48,0.13);
  font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
  font-size: 16px; line-height: 1.75; color: var(--black); width: 100%;
}

/* ── Container ───────────────────────────────────────────────────── */
.msv__container { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }
@media (max-width: 640px) { .msv__container { padding: 0 1.2rem; } }

/* ── Typography ──────────────────────────────────────────────────── */
.msv h1 {
  font-size: clamp(2.2rem, 5vw, 3.2rem); font-weight: 800; line-height: 1.1;
  color: var(--white); letter-spacing: -0.025em; margin-bottom: 1.3rem;
}
.msv h2 {
  font-size: clamp(1.4rem, 2.8vw, 1.9rem); font-weight: 700; color: var(--navy);
  letter-spacing: -0.01em; margin-bottom: 0.5rem;
  position: relative; display: inline-block; padding-bottom: 0.5rem;
}
.msv h2::after {
  content: ''; position: absolute; bottom: 0; left: 0;
  width: 48px; height: 3px;
  background: linear-gradient(90deg, var(--red), var(--red-deep)); border-radius: 2px;
}
.msv h3 { font-size: 1.05rem; font-weight: 700; color: var(--navy); margin-bottom: 0.4rem; }
.msv p { color: var(--black); margin-bottom: 1rem; font-size: 0.97rem; }
.msv a { color: var(--red); text-decoration: none; }
.msv a:hover { text-decoration: underline; }

/* ── Sections ────────────────────────────────────────────────────── */
.msv__section { padding: 6rem 0; background: var(--white); }
.msv__section--cream { padding: 6rem 0; background: linear-gradient(180deg, #f8f7f4 0%, #f2f4f8 100%); }
.msv__section--dark {
  padding: 6rem 0;
  background: linear-gradient(135deg, var(--navy) 0%, #0d2240 55%, #0a1d38 100%);
}
.msv__section--dark h2 { color: var(--white) !important; }
.msv__section--dark h2::after { background: linear-gradient(90deg, var(--yellow), #e8b820); }
.msv__section--dark p { color: rgba(255,255,255,0.82); }
@media (max-width: 640px) {
  .msv__section, .msv__section--cream, .msv__section--dark { padding: 3.5rem 0; }
}

/* ── Section heading ─────────────────────────────────────────────── */
.msv__section-hd { margin-bottom: 3.5rem; }
.msv__section-hd p { color: var(--muted); font-size: 1rem; margin-top: 1rem; line-height: 1.7; max-width: 600px; }
.msv__section--dark .msv__section-hd p { color: rgba(255,255,255,0.6); }
.msv__section-hd--centre { text-align: center; }
.msv__section-hd--centre p { margin-left: auto; margin-right: auto; }
.msv__section-hd--centre h2 { display: block; }
.msv__section-hd--centre h2::after { left: 50%; transform: translateX(-50%); }

/* ── Hero ────────────────────────────────────────────────────────── */
.msv__hero {
  background: linear-gradient(135deg, #0c1930 0%, #0f2540 40%, #162d50 70%, #1a3560 100%);
  padding: 6rem 0 5.5rem; position: relative; overflow: hidden;
}
.msv__hero::before {
  content: ''; position: absolute; top: -30%; right: -5%;
  width: 700px; height: 700px;
  background: radial-gradient(circle, rgba(190,0,17,0.1) 0%, transparent 65%);
  pointer-events: none;
}
.msv__hero::after {
  content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(250,207,57,0.4), transparent);
}
.msv__hero-inner { max-width: 780px; animation: msv-fade-up 0.7s ease-out both; }
.msv__eyebrow {
  display: inline-flex; align-items: center; gap: 0.5rem;
  background: rgba(190,0,17,0.15); border: 1px solid rgba(190,0,17,0.4);
  color: #ff6b7a; font-size: 0.72rem; font-weight: 700;
  letter-spacing: 0.12em; text-transform: uppercase;
  padding: 0.35rem 0.9rem; border-radius: 100px; margin-bottom: 1.6rem;
}
.msv__eyebrow::before {
  content: ''; width: 6px; height: 6px;
  background: var(--red); border-radius: 50%; box-shadow: 0 0 6px var(--red);
}
.msv__hero-sub {
  font-size: clamp(1rem, 2.2vw, 1.2rem);
  color: rgba(255,255,255,0.78) !important;
  max-width: 640px; margin-bottom: 2.5rem; line-height: 1.75;
}
.msv__hero p { color: rgba(255,255,255,0.78) !important; }

/* ── Buttons ─────────────────────────────────────────────────────── */
.msv__btn-group { display: flex; flex-wrap: wrap; gap: 0.85rem; }
.msv__btn {
  display: inline-block; padding: 0.9rem 2.1rem;
  font-size: 0.93rem; font-weight: 700; border-radius: 6px;
  text-decoration: none !important; transition: transform 0.15s, box-shadow 0.15s;
}
.msv__btn:hover { transform: translateY(-1px); text-decoration: none !important; }
.msv .msv__btn--primary {
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #ffffff !important; box-shadow: 0 4px 16px rgba(190,0,17,0.38);
}
.msv .msv__btn--primary:hover { box-shadow: 0 6px 22px rgba(190,0,17,0.48); color: #ffffff !important; }
.msv .msv__btn--outline-white {
  background: transparent; color: #ffffff !important; border: 1.5px solid rgba(255,255,255,0.5);
}
.msv .msv__btn--outline-white:hover { background: rgba(255,255,255,0.1); color: #ffffff !important; }
.msv .msv__btn--outline {
  background: transparent; color: var(--navy) !important; border: 2px solid var(--navy);
}
.msv .msv__btn--outline:hover { background: var(--navy); color: #ffffff !important; }

/* ── Trust bar ───────────────────────────────────────────────────── */
.msv__trust-bar {
  background: var(--white); border-bottom: 1px solid var(--border);
  padding: 1.1rem 0; box-shadow: var(--shadow-sm);
}
.msv__trust-bar-inner { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.75rem; }
.msv__trust-item {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 0.82rem; font-weight: 600; color: var(--navy); white-space: nowrap;
}
.msv__trust-item::before {
  content: ''; width: 7px; height: 7px;
  background: linear-gradient(135deg, var(--red), var(--red-deep));
  border-radius: 50%; flex-shrink: 0;
}

/* ── Visa option cards ───────────────────────────────────────────── */
.msv__options-grid {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem;
}
@media (max-width: 700px) { .msv__options-grid { grid-template-columns: 1fr; } }
.msv__option-card {
  background: var(--white); border: 1px solid var(--border);
  border-radius: 16px; padding: 2.2rem 2rem;
  display: grid; grid-template-rows: auto auto auto 1fr auto auto;
  box-shadow: var(--shadow-sm);
  transition: box-shadow 0.2s, transform 0.2s;
  position: relative; overflow: hidden;
}
.msv__option-card:hover { box-shadow: var(--shadow-md); transform: translateY(-3px); }
.msv__option-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5px;
}
.msv__option-card--nlv::before  { background: linear-gradient(90deg, #be0011, #e84055); }
.msv__option-card--dnv::before  { background: linear-gradient(90deg, #0c6ef5, #3a8fff); }
.msv__option-card--stu::before  { background: linear-gradient(90deg, #1a8c5b, #27b87a); }
.msv__option-card--ren::before  { background: linear-gradient(90deg, #7c4dff, #9c6fff); }
.msv__option-icon { font-size: 2rem; margin-bottom: 0.7rem; display: block; }
.msv__option-label {
  font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--muted); margin-bottom: 0.3rem;
}
.msv__option-title {
  font-size: 1.15rem; font-weight: 800; color: var(--navy);
  margin-bottom: 0.9rem; line-height: 1.25;
}
.msv__option-card p {
  font-size: 0.9rem; color: var(--muted); line-height: 1.7; margin-bottom: 1.3rem;
}
.msv__option-facts {
  display: flex; flex-direction: column; gap: 0.4rem;
  margin-bottom: 1.5rem;
  padding: 1rem 1.1rem;
  background: linear-gradient(180deg, #f8f7f4 0%, #f2f4f8 100%);
  border-radius: 10px;
  border: 1px solid var(--border);
}
.msv__fact {
  display: flex; align-items: flex-start; gap: 0.6rem;
  font-size: 0.83rem; color: var(--black); line-height: 1.4;
}
.msv__fact-icon { font-size: 0.85rem; flex-shrink: 0; margin-top: 0.05rem; }
.msv__fact strong { color: var(--navy); }
.msv__option-cta-group { display: flex; gap: 0.6rem; flex-wrap: wrap; }
.msv__option-btn-primary {
  flex: 1; display: block; padding: 0.7rem 1rem;
  background: linear-gradient(135deg, var(--navy), #1a3a6e);
  color: #ffffff !important; border-radius: 6px;
  font-size: 0.82rem; font-weight: 700;
  text-decoration: none !important; text-align: center;
  transition: box-shadow 0.15s;
}
.msv__option-btn-primary:hover {
  box-shadow: 0 4px 14px rgba(12,25,48,0.3);
  text-decoration: none !important; color: #ffffff !important;
}
.msv__option-btn-secondary {
  display: block; padding: 0.68rem 1rem;
  background: transparent; color: var(--muted) !important;
  border: 1px solid var(--border); border-radius: 6px;
  font-size: 0.8rem; font-weight: 600;
  text-decoration: none !important; text-align: center; white-space: nowrap;
  transition: background 0.15s, color 0.15s;
}
.msv__option-btn-secondary:hover {
  background: var(--cream); color: var(--navy) !important;
  text-decoration: none !important;
}

/* ── Comparison table ────────────────────────────────────────────── */
.msv__table-wrap { overflow-x: auto; border-radius: 12px; box-shadow: var(--shadow-sm); border: 1px solid var(--border); }
.msv__compare {
  width: 100%; border-collapse: collapse; font-size: 0.88rem;
  background: var(--white);
}
.msv__compare thead th {
  background: var(--navy); color: #ffffff;
  padding: 1rem 1.1rem; text-align: left;
  font-size: 0.8rem; font-weight: 700; letter-spacing: 0.02em;
}
.msv__compare thead th:first-child { border-radius: 12px 0 0 0; }
.msv__compare thead th:last-child  { border-radius: 0 12px 0 0; }
.msv__compare tbody tr { border-bottom: 1px solid var(--border); }
.msv__compare tbody tr:last-child  { border-bottom: none; }
.msv__compare tbody tr:nth-child(even) td { background: #f8f7f4; }
.msv__compare td {
  padding: 0.85rem 1.1rem; vertical-align: middle;
  color: var(--black); line-height: 1.5;
}
.msv__compare td:first-child { font-weight: 700; color: var(--navy); white-space: nowrap; }
.msv__tick   { color: #1a8c5b; font-weight: 800; }
.msv__cross  { color: #be0011; font-weight: 800; }
.msv__badge-nlv { display: inline-block; background: #fde8ea; color: #8c000d; border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.75rem; font-weight: 700; }
.msv__badge-dnv { display: inline-block; background: #e0edff; color: #0c4fa0; border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.75rem; font-weight: 700; }
.msv__badge-stu { display: inline-block; background: #d9f5ea; color: #116040; border-radius: 4px; padding: 0.15rem 0.5rem; font-size: 0.75rem; font-weight: 700; }
.msv__compare-note {
  font-size: 0.78rem; color: var(--muted);
  margin-top: 0.85rem; line-height: 1.6;
}

/* ── Already in Spain band ───────────────────────────────────────── */
.msv__renewal-band {
  background: linear-gradient(135deg, #f8f7f4 0%, #eef0f6 100%);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2.5rem 3rem;
  display: flex; align-items: center; gap: 3rem;
  margin-top: 3.5rem;
}
@media (max-width: 700px) {
  .msv__renewal-band { flex-direction: column; gap: 1.5rem; padding: 2rem 1.5rem; }
}
.msv__renewal-icon { font-size: 3rem; flex-shrink: 0; }
.msv__renewal-body { flex: 1; }
.msv__renewal-body h3 { font-size: 1.1rem; margin-bottom: 0.4rem; }
.msv__renewal-body p { font-size: 0.92rem; color: var(--muted); margin: 0 0 1.2rem; }

/* ── Not sure band ───────────────────────────────────────────────── */
.msv__unsure-band {
  background: linear-gradient(135deg, var(--navy) 0%, #1a3a5c 100%);
  border-radius: 16px; padding: 3rem;
  display: flex; align-items: center; gap: 3rem;
  margin: 0 auto;
}
@media (max-width: 700px) {
  .msv__unsure-band { flex-direction: column; gap: 1.5rem; padding: 2rem 1.5rem; text-align: center; }
}
.msv__unsure-text { flex: 1; }
.msv__unsure-text h3 { color: #ffffff !important; font-size: 1.2rem; margin-bottom: 0.5rem; }
.msv__unsure-text p { color: rgba(255,255,255,0.75) !important; font-size: 0.93rem; margin: 0; }
.msv__unsure-actions { display: flex; flex-direction: column; gap: 0.65rem; flex-shrink: 0; min-width: 220px; }
.msv__unsure-btn-primary {
  display: block; padding: 0.85rem 1.5rem;
  background: var(--red); color: #ffffff !important;
  border-radius: 6px; font-size: 0.88rem; font-weight: 700;
  text-decoration: none !important; text-align: center;
  box-shadow: 0 4px 14px rgba(190,0,17,0.35);
  transition: box-shadow 0.15s;
}
.msv__unsure-btn-primary:hover { box-shadow: 0 6px 20px rgba(190,0,17,0.5); text-decoration: none !important; color: #ffffff !important; }
.msv__unsure-btn-secondary {
  display: block; padding: 0.82rem 1.5rem;
  background: transparent; color: rgba(255,255,255,0.85) !important;
  border: 1.5px solid rgba(255,255,255,0.35); border-radius: 6px;
  font-size: 0.86rem; font-weight: 600;
  text-decoration: none !important; text-align: center;
  transition: background 0.15s;
}
.msv__unsure-btn-secondary:hover { background: rgba(255,255,255,0.1); text-decoration: none !important; color: #ffffff !important; }

/* ── FAQ ─────────────────────────────────────────────────────────── */
.msv__faq-list { max-width: 760px; margin: 0 auto; }
.msv__faq-item { border-bottom: 1px solid var(--border); padding: 1.5rem 0; }
.msv__faq-item:first-child { border-top: 1px solid var(--border); }
.msv__faq-q {
  font-size: 1rem; font-weight: 700; color: var(--navy);
  cursor: pointer; list-style: none;
  display: flex; justify-content: space-between; align-items: center; gap: 1rem;
}
.msv__faq-q::after { content: '+'; font-size: 1.3rem; font-weight: 400; color: var(--red); flex-shrink: 0; }
details[open] .msv__faq-q::after { content: '−'; }
.msv__faq-a { font-size: 0.94rem; color: var(--muted); line-height: 1.8; padding-top: 0.85rem; }
.msv__faq-a p { margin: 0 0 0.6rem; color: var(--muted); }
.msv__faq-a p:last-child { margin: 0; }

/* ── Final CTA ───────────────────────────────────────────────────── */
.msv__final-cta {
  background: linear-gradient(135deg, var(--navy) 0%, #0f2540 50%, #0c1930 100%);
  padding: 6rem 0; text-align: center; position: relative; overflow: hidden;
}
.msv__final-cta::before {
  content: ''; position: absolute; top: -40%; left: 50%; transform: translateX(-50%);
  width: 800px; height: 800px;
  background: radial-gradient(circle, rgba(190,0,17,0.08) 0%, transparent 65%);
  pointer-events: none;
}
.msv__final-cta h2 {
  color: #ffffff !important; font-size: clamp(1.7rem, 3.5vw, 2.5rem);
  display: block; padding-bottom: 0; margin-bottom: 1rem;
}
.msv__final-cta h2::after { display: none; }
.msv__final-cta p { color: rgba(255,255,255,0.72) !important; max-width: 540px; margin: 0 auto 2.5rem; font-size: 1rem; }
.msv__final-cta .msv__btn-group { justify-content: center; }

/* ── Disclaimer ──────────────────────────────────────────────────── */
.msv__disclaimer {
  background: #f2f4f8; border-top: 1px solid var(--border); padding: 1.5rem 0;
}
.msv__disclaimer p { font-size: 0.78rem; color: var(--muted); text-align: center; margin: 0; line-height: 1.7; }

/* ── Animations ──────────────────────────────────────────────────── */
@keyframes msv-red-pulse {
  0%   { color: #be0011; text-shadow: 0 0 12px rgba(190,0,17,0.0); }
  50%  { color: #ff2235; text-shadow: 0 0 28px rgba(190,0,17,0.65), 0 0 52px rgba(190,0,17,0.35); }
  100% { color: #be0011; text-shadow: 0 0 12px rgba(190,0,17,0.0); }
}
@keyframes msv-shimmer {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes msv-white-shimmer {
  0%   { background-position: 0% 50%; }
  50%  { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes msv-fade-up {
  0%   { opacity: 0; transform: translateY(14px); }
  100% { opacity: 1; transform: translateY(0); }
}
.msv__spark {
  animation: msv-red-pulse 2.8s ease-in-out infinite; display: inline;
}
.msv__shimmer {
  background: linear-gradient(90deg, #be0011, #ff6b7a, #facf39, #be0011);
  background-size: 300% 300%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: msv-shimmer 4s ease-in-out infinite; display: inline;
}
.msv__white-shimmer {
  background: linear-gradient(90deg, #ffffff, #facf39, #ffffff, #a8c8ff, #ffffff);
  background-size: 300% 300%;
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: msv-white-shimmer 4s ease-in-out infinite; display: inline;
}
</style>

