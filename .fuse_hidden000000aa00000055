.msv-nav__burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.4rem;
  border-radius: 5px;
}
.msv-nav__burger span {
  width: 22px;
  height: 2px;
  background: #fff;
  border-radius: 2px;
  transition: transform 0.2s, opacity 0.2s;
  display: block;
}

/* Mobile nav */
.msv-nav__mobile {
  display: none;
  flex-direction: column;
  background: var(--navy-mid);
  padding: 1rem 1.5rem 1.5rem;
  border-top: 1px solid rgba(255,255,255,0.1);
}
.msv-nav__mobile.open { display: flex; }
.msv-nav__mobile a {
  padding: 0.65rem 0;
  color: rgba(255,255,255,0.9);
  font-size: 0.95rem;
  font-weight: 600;
  text-decoration: none;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}
.msv-nav__mobile a:hover { color: var(--yellow); }
.msv-nav__mobile .msv-nav__mobile-sub {
