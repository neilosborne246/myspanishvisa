# ─────────────────────────────────────────────────────────────
# My Spanish Visa — Apache Configuration
# ─────────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Redirect .html extension URLs to clean URL (must come before clean-URL serve rule)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Blog clean URLs FIRST: /blog/slug or /blog/slug/ → blog-slug.html
# (must come before trailing-slash removal and generic clean-URL rule)
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-$1.html [L]

# Remove trailing slash (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve clean URLs — strip .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ── Legacy URL redirects ──────────────────────────────────────
# Blog index — exact match only so /blog/slug/ routes fall through to the rewrite below
RedirectMatch 301 ^/blog(/?)$               /blog-index
# URL aliases (old or alternative slugs → canonical clean URL)
Redirect 301 /spain-nie-number/             /nie-number-spain
Redirect 301 /spain-tie-card/               /tie-card-spain
Redirect 301 /compare-spain-visas/          /best-visa-move-to-spain
Redirect 301 /spain-visa-requirements/      /spain-visa-options
Redirect 301 /non-lucrative-visa-uk/        /nlv-uk
Redirect 301 /digital-nomad-visa-uk/        /dnv-uk
Redirect 301 /how-long-does-nlv-take/       /blog-how-long-does-nlv-take

# ── Caching ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
