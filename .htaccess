# ─────────────────────────────────────────────────────────────
# My Spanish Visa — Apache Configuration
# ─────────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve clean URLs — strip .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ /$1.html [L]

# Remove trailing slash (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# ── Legacy WordPress URL redirects ───────────────────────────
Redirect 301 /non-lucrative-visa-spain/ /non-lucrative-visa-spain.html
Redirect 301 /digital-nomad-visa-spain/ /digital-nomad-visa-spain.html
Redirect 301 /student-visa-spain/ /student-visa-spain.html
Redirect 301 /spain-visa-renewal/ /spain-visa-renewal.html
Redirect 301 /blog/ /blog-index.html
Redirect 301 /about-us/ /about-us.html
Redirect 301 /testimonials/ /testimonials.html
Redirect 301 /why-choose-us/ /why-choose-us.html
Redirect 301 /contact-us/ /contact-us.html
Redirect 301 /move-to-spain/ /move-to-spain.html
Redirect 301 /faq/ /faq.html
Redirect 301 /services/ /services.html
Redirect 301 /nie-number-spain/ /nie-number-spain.html
Redirect 301 /spain-nie-number/ /nie-number-spain.html
Redirect 301 /tie-card-spain/ /tie-card-spain.html
Redirect 301 /spain-tie-card/ /tie-card-spain.html
Redirect 301 /compare-spain-visas/ /best-visa-move-to-spain.html
Redirect 301 /spain-visa-requirements/ /spain-visa-options.html
Redirect 301 /non-lucrative-visa-uk/ /nlv-uk.html
Redirect 301 /digital-nomad-visa-uk/ /dnv-uk.html
Redirect 301 /how-long-does-nlv-take/ /blog-how-long-does-nlv-take.html

# ── Caching ──────────────────────────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
