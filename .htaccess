# ─────────────────────────────────────────────────────────────
# My Spanish Visa — Apache Configuration
# ─────────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Removed non-site files (archived on branch archive/served-copies-20261017) ──
# 1) Copied myspanishnlv.com pages → their live originals, path for path (301). All 378 verified live (titles match).
#    Two originals redirect on their own site, so point straight at the final URL.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/183-day-rule-spain-tax(?:\.html)?$ https://myspanishnlv.com/blog/183-day-rule-spain-tax-status.html [R=301,L]
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/nlv-renewal-documents-2026-checklist(?:\.html)?$ https://myspanishnlv.com/blog/nlv-renewal-documents-2026.html [R=301,L]
#    One original has an accented slug; send it percent-encoded.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/spain-nlv-padr.+n-registration-requirements(?:\.html)?$ https://myspanishnlv.com/blog/spain-nlv-padr\%C3\%B3n-registration-requirements.html [R=301,L,NE]
#    Page URLs = .html or no extension; content-recovery/ is excluded (no originals) and falls through to 410.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/(?!content-recovery/)((?:[^/]+/)*[^/.]+)(?:\.html)?$ https://myspanishnlv.com/$1.html [R=301,L,NE]

# 2) Copied myspanishdnv.com homepage → the original (its own canonical).
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ DNV/index(?:\.html)?$ https://myspanishdnv.com/ [R=301,L]

# 3) Everything else in the copied/draft folders: 410 Gone.
RewriteRule ^(?:Documents|Blog\ Posts|Social\ Posts)(?:/|$) - [G,L]

# 4) Internal working files at the root: 404 (never meant to be public).
RewriteRule ^(?:[^/]+\.(?:md|py|sh|docx)|_headers|_redirects|\.DS_Store)$ - [R=404,L]

# 5) PDFs (dnv-document-checklist, moving-to-spain-checklist, nlv-document-checklist) are kept and still served.

# Redirect .html extension URLs to clean URL (must come before clean-URL serve rule)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Blog clean URLs FIRST: /blog/slug or /blog/slug/ → blog-slug.html
# (must come before trailing-slash removal and generic clean-URL rule)
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-$1.html [L]

# Remove trailing slash (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve clean URLs — strip .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# ── Legacy URL redirects ──────────────────────────────────────
# Blog index — exact match only so /blog/slug/ routes fall through to the rewrite below
RedirectMatch 301 ^/blog(/?)$               /blog-index
# URL aliases (old or alternative slugs → canonical clean URL)
Redirect 301 /spain-nie-number/             /nie-number-spain
Redirect 301 /spain-tie-card/               /tie-card-spain
Redirect 301 /compare-spain-visas/          /best-visa-move-to-spain
Redirect 301 /spain-visa-requirements/      /spain-visa-options
Redirect 301 /non-lucrative-visa-uk/        /nlv-uk
Redirect 301 /digital-nomad-visa-uk/        /dnv-uk
Redirect 301 /how-long-does-nlv-take/       /blog-how-long-does-nlv-take

# ── Caching ──────────────────────────────────────────────────
# HTML: never cache — changes must appear instantly
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Static assets: cache aggressively (CSS/JS/images have versioned URLs or change rarely)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
