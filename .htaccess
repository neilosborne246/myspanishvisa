# ─────────────────────────────────────────────────────────────
# My Spanish Visa — Apache Configuration
# ─────────────────────────────────────────────────────────────

Options -Indexes
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old WordPress-style category URLs /blog/category/<slug>/ -> the matching static category page (one hop); anything else under it -> 410
RewriteCond %{DOCUMENT_ROOT}/blog-category-$1.html -f
RewriteRule ^blog/category/([a-z0-9-]+)/?$ https://www.myspanishvisa.com/blog-category-$1 [R=301,L,NC]
RewriteRule ^blog/category(?:/.*)?$ - [G,L,NC]

# Force www
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Removed non-site files (archived on branch archive/served-copies-20261017) ──
# 1) Copied myspanishnlv.com pages → their live originals, path for path (301). All 378 verified live (titles match).
#    Two originals redirect on their own site, so point straight at the final URL.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/183-day-rule-spain-tax(?:\.html)?$ https://myspanishnlv.com/blog/183-day-rule-spain-tax-status.html [R=301,L]
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/nlv-renewal-documents-2026-checklist(?:\.html)?$ https://myspanishnlv.com/blog/nlv-renewal-documents-2026.html [R=301,L]
#    One original has an accented slug; send it percent-encoded.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/blog/spain-nlv-padr.+n-registration-requirements(?:\.html)?$ https://myspanishnlv.com/blog/spain-nlv-padr\%C3\%B3n-registration-requirements.html [R=301,L,NE]
#    Page URLs = .html or no extension; content-recovery/ is excluded (no originals) and falls through to 410.
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ NLV/(?!content-recovery/)((?:[^/]+/)*[^/.]+)(?:\.html)?$ https://myspanishnlv.com/$1.html [R=301,L,NE]

# 2) Copied myspanishdnv.com homepage → the original (its own canonical).
RewriteRule ^Documents/Claude/Projects/My\ Spanish\ DNV/index(?:\.html)?$ https://myspanishdnv.com/ [R=301,L]

# 3) Everything else in the copied/draft folders: 410 Gone.
RewriteRule ^(?:Documents|Blog\ Posts|Social\ Posts)(?:/|$) - [G,L]

# 4) Internal working files at the root: 404 (never meant to be public).
RewriteRule ^(?:[^/]+\.(?:md|py|sh|docx)|_headers|_redirects|\.DS_Store)$ - [R=404,L]

# 4b) Working files removed in the Nov 2026 public-file cleanup: 410 Gone (both the .html and extensionless draft URL).
RewriteRule ^(?:MSV_AboutUs_SEO_Schema(?:\.html)?|_cta_fix_log\.txt|_wrap_log\.txt)$ - [G,L]

# 4b2) Old duplicate home page (homepage.html, no canonical, no known references or search use) -> the home page.
RewriteRule ^homepage(?:\.html)?/?$ / [R=301,L]

# 4c) Build partials, templates and schema working files: never public pages. 410 Gone (extensionless and .html).
#     Files stay in the repo; no page or script loads them at runtime (checked 23 Nov 2026).
RewriteRule ^(?:msv-menu|msv-footer|msv-navigation-menu|_template|MSV_ContactUs_SEO_Schema|MSV_MoveToSpain_SEO_Schema|MSV_SpainVisaOptions_SEO_Schema|MSV_TIE_Guides_SEO|MSV_JSON_LD_Schema_All_Pages)(?:\.html)?$ - [G,L]

# 4d) The error page itself answers 404 when requested directly (/404, /404.html).
#     REDIRECT_STATUS is empty only for direct requests, so ErrorDocument 404 /404.html keeps working.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteRule ^404(?:\.html)?$ - [R=404,L]

# 5) PDFs (dnv-document-checklist, moving-to-spain-checklist, nlv-document-checklist) are kept and still served.

# Student "renewal" is an extension of stay: one page owns the intent
RewriteRule ^student-visa-spain-renewal(?:\.html)?/?$ https://www.myspanishvisa.com/student-visa-spain-extension [R=301,L]

# Flat blog duplicates → the canonical /blog/slug/ URL in one hop (the .html and trailing-slash variants included).
# Matched on THE_REQUEST so the internal /blog/slug/ → blog-slug.html rewrite below never loops back here.
# Explicit list: the 314 posts in sitemap.xml (generated 23 Nov 2026). Category pages, blog-index and the 3 insurer-named stubs are excluded.
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(90-day-rule-spain|americans-moving-to-spain-mistakes|apostille-spain-visa-documents|appeal-spain-visa-refusal-process|australians-spain-no-tax-treaty|beckham-law-digital-nomad-visa-spain|beckham-law-spain-explained-who-qualifies|beckham-law-spain-how-to-apply|best-banks-spain-expats-2026|best-cities-live-spain-expats|best-cities-spain-digital-nomads-2026|best-cities-spain-retirees-2026|best-health-insurance-digital-nomad-visa|best-language-schools-spain-visa|best-places-live-spain|best-places-live-spain-expat-2026|best-places-retire-spain|best-private-health-insurance-spain-expats-2026|best-spain-visa-families-2026|best-spain-visa-remote-workers-2026|best-spain-visa-retirees-2026|best-visa-spain-remote-workers|birth-certificate-spain-visa|buy-to-let-spain|buying-house-spain|buying-property-spain-foreigner-visa-legal|can-i-bring-family-spain-visa|can-i-live-spain-permanently-foreigner|can-i-move-to-spain-from-uk-after-brexit|can-i-rent-property-on-nlv|can-you-work-on-non-lucrative-visa|can-you-work-remotely-non-lucrative-visa-spain|canadians-retiring-spain-taxes|canary-islands-expat-visa-guide|capital-gains-tax-spain-expats|certified-documents-spain-visa|changing-visa-type-spain|cheapest-cities-spain|cita-previa-spain-how-to-book|convenio-especial-spain|convert-student-visa-work-permit-spain|cost-of-living-spain|cost-of-living-spain-2026|cost-of-living-spain-expats-2026|couples-non-lucrative-visa-spain-joint-application|criminal-record-certificate-spain-visa|digital-certificate-spain-foreigners|digital-nomad-visa-barcelona|digital-nomad-visa-best-country-passport|digital-nomad-visa-fuerteventura|digital-nomad-visa-gran-canaria|digital-nomad-visa-ibiza|digital-nomad-visa-lanzarote|digital-nomad-visa-madrid|digital-nomad-visa-malaga)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(digital-nomad-visa-murcia|digital-nomad-visa-palma-de-mallorca|digital-nomad-visa-san-sebastian|digital-nomad-visa-seville|digital-nomad-visa-spain-employer-letter-documents|digital-nomad-visa-spain-family-dependants|digital-nomad-visa-spain-income-requirements|digital-nomad-visa-spain-processing-times-consulate|digital-nomad-visa-spain-rejection-reasons|digital-nomad-visa-spain-vs-portugal|digital-nomad-visa-tenerife|digital-nomad-visa-valencia|digital-nomad-visa-vs-non-lucrative-visa-spain|dnv-beckham-law-explained|dnv-coworking-spaces-spain|dnv-employer-letter-template|dnv-family-application|dnv-from-uk-after-brexit|dnv-internet-speed-spain|dnv-renewal-guide|dnv-self-employed-spain|dnv-us-citizens-guide|dnv-vs-non-lucrative-visa|do-i-need-visa-live-spain|do-you-need-visa-buy-property-spain|driving-in-spain-expat-guide|easiest-way-move-to-spain|empadronamiento-guide|eu-long-term-residency-spain|family-health-insurance-spain|financial-proof-spain-visa-guide|finding-expat-community-spain|first-30-days-spain-post-arrival-checklist|foreigner-mortgage-spain-guide|forgot-renew-spain-visa-what-happens|freelancer-visa-options-spain|health-insurance-spain|health-insurance-spain-cost-guide|health-insurance-spain-for-retirees|health-insurance-spain-pre-existing-conditions|health-insurance-spain-when-to-apply|healthcare-registration-spain-expats|healthcare-spain-expats|healthcare-spain-expats-guide|highly-qualified-professional-visa-spain|horizontal-property-law-spain|how-long-does-nlv-take|how-long-does-spain-visa-take|how-long-leave-spain-non-lucrative-visa|how-long-move-to-spain-timeline|how-long-stay-spain-without-visa|how-much-money-move-to-spain|how-to-get-nie-number-spain|how-to-get-residency-spain-foreigners|how-to-register-padron-spain-empadronamiento)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(iprem-explained-nlv-application-spain|irish-expats-spain-eu-advantage|is-it-hard-get-spain-visa|is-spain-good-place-retire-pros-cons|learning-spanish-expat-do-you-need-it|learning-spanish-expats|living-in-alicante-expat-guide|living-in-andalusia-expat-guide|living-in-bilbao-expat-guide|living-in-costa-del-sol-expat-guide|living-in-fuerteventura-expat-guide|living-in-gran-canaria-expat-guide|living-in-ibiza-expat-guide|living-in-lanzarote-expat-guide|living-in-marbella-expat-guide|living-in-murcia-expat-guide|living-in-san-sebastian-expat-guide|living-in-seville-expat-guide|living-in-tenerife-expat-guide|living-in-torrevieja-expat-guide|mallorca-expat-guide|marriage-certificate-spain-visa|modelo-720-spain-foreign-assets|mortgages-spain-non-residents|move-to-spain-remote-worker|moving-to-barcelona-visa-expat-guide|moving-to-canary-islands|moving-to-canary-islands-tenerife-gran-canaria|moving-to-granada-expat-guide|moving-to-madrid-visa-expat-guide|moving-to-malaga-expat-guide|moving-to-mallorca|moving-to-spain-complete-guide-2026|moving-to-spain-from-australia|moving-to-spain-from-canada|moving-to-spain-from-ireland|moving-to-spain-from-new-zealand|moving-to-spain-from-south-africa|moving-to-spain-from-uk|moving-to-spain-from-uk-after-brexit|moving-to-spain-from-usa|moving-to-spain-with-dogs|moving-to-valencia-visa-expat-guide|nie-number-buying-property-spain|nie-spain-appointment-how-to-book|nie-vs-tie-spain-difference|nlv-apostille-translation-guide|nlv-bank-statements-guide|nlv-buying-property-spain|nlv-criminal-record-check|nlv-health-insurance-requirements|nlv-how-much-money-do-i-need|nlv-renewal-documents-checklist-2026|nlv-renewal-mistakes|nlv-to-permanent-residency)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(nlv-vs-digital-nomad-visa|nlv-vs-digital-nomad-visa-2026|nlv-vs-student-visa-spain|nlv-with-children|no-copay-health-insurance-spain-visa|non-lucrative-visa-spain-after-approval|non-lucrative-visa-spain-guide|non-lucrative-visa-spain-health-insurance-requirements|non-lucrative-visa-spain-processing-times-consulate|non-lucrative-visa-spain-rejection-reasons|non-lucrative-visa-vs-golden-visa-spain|open-bank-account-spain|opening-bank-account-spain-foreigner|opening-spanish-bank-account-guide|path-to-spanish-citizenship-how-long|pay-tax-spain-foreigner|pets-moving-to-spain|pets-moving-to-spain-requirements|pitfalls-buying-property-spain|private-health-insurance-spain-expat|proof-of-address-spain-visa|property-lawyer-spain|prove-passive-income-non-lucrative-visa-spain|public-vs-private-healthcare-spain-comparison|real-estate-lawyer-spain|reapply-after-spain-visa-rejection|register-autonomo-spain-digital-nomad-visa|registering-car-spain-foreigner|renew-digital-nomad-visa-spain|renew-non-lucrative-visa-spain|renew-student-visa-spain|renewal-while-outside-spain|renting-apartment-spain-foreigner|renting-in-spain-first-apartment|renting-spain-foreigner-guide|renting-vs-buying-spain-expat|retirement-visa-spain-options-compared|retiring-in-barcelona|retiring-in-fuerteventura|retiring-in-gran-canaria|retiring-in-ibiza|retiring-in-lanzarote|retiring-in-madrid|retiring-in-malaga|retiring-in-marbella|retiring-in-murcia|retiring-in-palma-de-mallorca|retiring-in-san-sebastian|retiring-in-seville|retiring-in-tenerife|retiring-in-torrevieja|retiring-in-valencia|retiring-spain-vs-portugal-vs-france|schools-spain-expat-children|sending-money-spain-best-options)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(south-africans-moving-to-spain|spain-bureaucracy-guide-foreigners|spain-culture-shock-what-to-expect|spain-digital-nomad-visa-tax|spain-double-taxation-treaties-expats|spain-driving-licence-foreigners-exchange|spain-dual-nationality-citizenship|spain-entrepreneur-visa-startup-visa|spain-foreigner-registration-certificate|spain-golden-visa-abolished-alternatives|spain-healthcare-system-expats-public-private|spain-income-tax-return-expats-guide|spain-inheritance-tax-expats|spain-long-term-rental-vs-buying|spain-long-term-residency-renewal|spain-medical-certificate-requirements|spain-mobile-phone-sim-expat|spain-nlv-vs-golden-visa|spain-permanent-residency-after-5-years|spain-property-taxes-buyer-guide|spain-rental-contracts-explained|spain-residency-refused-appeal-options|spain-residency-renewal-timeline-documents|spain-social-security-number-foreigners|spain-student-visa-acceptance-letter-requirements|spain-student-visa-financial-requirements-iprem|spain-student-visa-over-30|spain-student-visa-processing-times-2026|spain-student-visa-rejection-common-mistakes|spain-tax-expats-guide-2026|spain-tie-card-explained-how-to-get|spain-utilities-setup-guide|spain-visa-costs-fees-2026|spain-visa-document-checklist-2026|spain-visa-early-renewal-guide|spain-visa-interview-what-to-expect|spain-visa-medical-certificate|spain-visa-photos-requirements|spain-visa-rejected-what-next|spain-visa-rejected-what-to-do|spain-visa-rejection-reasons-common-mistakes|spain-visa-renewal-denied-what-to-do|spain-visa-renewal-documents-checklist-2026|spain-visa-renewal-guide-2026|spain-visa-renewal-health-insurance|spain-visa-renewal-income-requirements|spain-visa-renewal-refused-what-to-do|spain-visa-renewal-timeline-guide|spain-vs-france-retirees-comparison|spain-vs-italy-expat-comparison|spain-vs-portugal-expats-comparison|spain-wealth-tax-foreigners|spain-weather-region-best-climate-expats|spain-work-permit-employed-workers|spanish-bureaucracy-survival-guide)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/blog-(spanish-citizenship-by-descent|spanish-citizenship-naturalisation-guide|spanish-drivers-licence|spanish-passport-visa-free-countries|spanish-social-security-number-guide|spanish-tax-system-expats-explained|start-business-spain|student-visa-barcelona-spain|student-visa-madrid-spain|student-visa-malaga-spain|student-visa-murcia-spain|student-visa-renewal-spain-guide|student-visa-san-sebastian-spain|student-visa-seville-spain|student-visa-spain-americans|student-visa-spain-bring-family|student-visa-spain-common-rejections|student-visa-spain-financial-proof|student-visa-spain-health-insurance|student-visa-spain-language-school|student-visa-spain-requirements-2026|student-visa-spain-to-work-permit|student-visa-spain-uk-students|student-visa-spain-work-hours|student-visa-valencia-spain|student-visa-vs-digital-nomad-visa-spain|switching-health-insurance-spain|sworn-translation-spain-visa|taxes-non-lucrative-visa-spain|temporary-vs-permanent-residency-spain|tie-card-renewal-complete-guide|uk-citizens-spain-after-brexit|uk-pension-spain|us-social-security-spain|utilities-phone-spain-foreigner|visa-compliant-health-insurance-spain|what-happens-if-spain-visa-not-renewed|which-spain-visa-right-for-me|work-while-studying-spain-student-visa)(?:\.html)?/?(?:[?\s])
RewriteRule ^ /blog/%1/ [R=301,L]

# Redirect .html extension URLs to clean URL (must come before clean-URL serve rule)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/([^?\s]+)\.html[\s?]
RewriteRule ^ /%1 [R=301,L]

# Blog clean URLs FIRST: /blog/slug or /blog/slug/ → blog-slug.html
# (must come before trailing-slash removal and generic clean-URL rule)
RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-$1.html [L]

# Remove trailing slash (except root)
RewriteCond %{REQUEST_URI} ^/(.+)/$
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Serve clean URLs — strip .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteCond %{REQUEST_URI} !\.html$
RewriteRule ^(.*)$ $1.html [L]

# ── Legacy URL redirects ──────────────────────────────────────
# Blog index — exact match only so /blog/slug/ routes fall through to the rewrite below
RedirectMatch 301 ^/blog(/?)$               /blog-index
# URL aliases (old or alternative slugs → canonical clean URL)
Redirect 301 /spain-nie-number/             /nie-number-spain
Redirect 301 /spain-tie-card/               /tie-card-spain
Redirect 301 /compare-spain-visas/          /best-visa-move-to-spain
Redirect 301 /spain-visa-requirements/      /spain-visa-options
Redirect 301 /non-lucrative-visa-uk/        /nlv-uk
Redirect 301 /digital-nomad-visa-uk/        /dnv-uk
Redirect 301 /how-long-does-nlv-take/       /blog/how-long-does-nlv-take/

# ── Caching ──────────────────────────────────────────────────
# HTML: never cache — changes must appear instantly
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Static assets: cache aggressively (CSS/JS/images have versioned URLs or change rarely)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# ── Compression ──────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Security headers ─────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html
