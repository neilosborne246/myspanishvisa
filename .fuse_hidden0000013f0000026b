/* ── Brand tokens (root-level so all fragments inherit) ── */
:root {
  --navy:      #0c1930;
  --navy-mid:  #1a3a5c;
  --red:       #be0011;
  --red-deep:  #8c000d;
  --yellow:    #facf39;
