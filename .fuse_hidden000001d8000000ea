/* HubSpot overrides */
.msv__form-col .hs-form fieldset{max-width:100% !important}
.msv__form-col .hs-form .hs-form-field{margin-bottom:1.1rem !important}
.msv__form-col .hs-form label{display:block !important;font-size:0.83rem !important;font-weight:600 !important;color:var(--navy) !important;margin-bottom:0.35rem !important;font-family:'Inter','Segoe UI',system-ui,sans-serif !important}
.msv__form-col .hs-form .hs-input{width:100% !important;padding:0.72rem 1rem !important;border:1.5px solid #dce3ed !important;border-radius:6px !important;font-size:0.94rem !important;color:#1a1a1a !important;background:#ffffff !important;font-family:'Inter','Segoe UI',system-ui,sans-serif !important;transition:border-color 0.15s,box-shadow 0.15s !important;box-sizing:border-box !important}
