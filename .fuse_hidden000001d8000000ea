/* PAGE */
.msv *,.msv *::before,.msv *::after{box-sizing:border-box;margin:0;padding:0}
.msv{--navy:#0c1930;--navy-mid:#1a3a5c;--red:#be0011;--red-deep:#8c000d;--yellow:#facf39;--cream:#f8f7f4;--white:#ffffff;--black:#1a1a1a;--muted:#5a6478;--border:#dce3ed;--shadow-sm:0 2px 8px rgba(12,25,48,0.08);--shadow-md:0 6px 24px rgba(12,25,48,0.13);--shadow-lg:0 12px 40px rgba(12,25,48,0.18);font-family:'Inter','Segoe UI',system-ui,Arial,sans-serif;font-size:16px;line-height:1.75;color:var(--black);width:100%}
