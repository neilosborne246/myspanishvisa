.msv__faq details[open] summary::after{content:'−'}
.msv__faq-body{padding:0 1.3rem 1.1rem;font-size:0.92rem;color:var(--muted);line-height:1.75}
.msv__faq-body p{color:var(--muted);margin-bottom:0}

