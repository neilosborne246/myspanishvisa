/* FAQ */
.msv__faq{background:var(--cream);border-top:1px solid var(--border);padding:5rem 0}
.msv__faq-label{font-size:0.7rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:var(--red);margin-bottom:0.5rem;display:block}
.msv__faq h2{font-size:1.5rem;font-weight:800;color:var(--navy);margin-bottom:2rem;display:block}
.msv__faq h2::after{display:none}
.msv__faq details{background:var(--white);border:1px solid var(--border);border-radius:10px;margin-bottom:10px;overflow:hidden}
.msv__faq summary{padding:1.1rem 1.3rem;font-size:0.97rem;font-weight:700;color:var(--navy);cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:center}
