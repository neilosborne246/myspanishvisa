        <h2>Document Checklist for Miami Consulate Applicants</h2>
      </div>
      <div class="msv__two-col">
        <div class="msv__checklist">
          <h3>Identity &amp; Legal</h3>
          <ul>
            <li>Valid US passport (6+ months remaining, 2 blank pages)</li>
            <li>2"×2" passport photos (white background, recent)</li>
            <li>Form EX-01 (2 signed copies)</li>
            <li>FBI Identity History Summary + US State Dept apostille</li>
            <li>Certified Spanish translation of FBI check</li>
          </ul>
        </div>
        <div class="msv__checklist">
          <h3>Health &amp; Insurance</h3>
          <ul>
            <li>Medical certificate from US-licensed physician</li>
            <li>Certified Spanish translation of medical certificate</li>
            <li>Spain-registered private health insurance certificate</li>
            <li>Policy must show: no copays, no exclusions, full coverage</li>
          </ul>
        </div>
