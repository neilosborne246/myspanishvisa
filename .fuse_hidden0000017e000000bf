/* ── iOS overflow safety ── */
html, body { max-width: 100%; overflow-x: clip; margin: 0; padding: 0; }
*, *::before, *::after { box-sizing: border-box; }

/* ── Brand tokens (root-level so all fragments inherit) ── */
:root {
  --navy:      #0c1930;
  --navy-mid:  #1a3a5c;
  --red:       #be0011;
  --red-deep:  #8c000d;
  --yellow:    #facf39;
  --cream:     #f8f7f4;
  --white:     #ffffff;
  --black:     #1a1a1a;
  --muted:     #5a6478;
  --border:    #dce3ed;
  --shadow-sm: 0 2px 8px rgba(12,25,48,0.08);
  --shadow-md: 0 6px 24px rgba(12,25,48,0.13);
}

body {
  font-family: 'Inter', 'Segoe UI', system-ui, Arial, sans-serif;
  font-size: 16px;
  line-height: 1.75;
  color: var(--black);
  background: #fff;
}

