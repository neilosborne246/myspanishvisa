<script>
const exchangeRates = {
  'EUR': 1.00,
  'GBP': 0.86,
  'USD': 1.08,
  'CAD': 1.48,
  'AUD': 1.65,
  'ZAR': 20.00,
  'CHF': 0.94
};

const smiMonthly = 1184;
const primaryRequirement = smiMonthly * 12 * 2; // 200% of SMI
const familyRequirement = smiMonthly * 12 * 0.75; // 75% of SMI

const beckhamToggle = document.getElementById('dnv-beckham');
beckhamToggle.addEventListener('click', function() {
  const isActive = this.getAttribute('data-active') === 'true';
  this.setAttribute('data-active', !isActive);
  this.classList.toggle('active');
});

function formatCurrency(value, currency = 'EUR') {
  const symbols = { 'EUR': '€', 'GBP': '£', 'USD': '$', 'CAD': '$', 'AUD': '$', 'ZAR': 'R', 'CHF': 'Fr' };
  const symbol = symbols[currency] || currency;
  return symbol + ' ' + value.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
}

function calculateDNV() {
  const employmentType = document.getElementById('dnv-employment-type').value;
  const applicants = parseInt(document.getElementById('dnv-applicants').value);
  const currency = document.getElementById('dnv-currency').value;
  const monthlyIncome = parseFloat(document.getElementById('dnv-monthly-income').value) || 0;
  const useBeckham = beckhamToggle.getAttribute('data-active') === 'true';

  const exchangeRate = exchangeRates[currency];
  const monthlyIncomeEUR = monthlyIncome / exchangeRate;
  const annualIncomeEUR = monthlyIncomeEUR * 12;

  const totalRequirementEUR = primaryRequirement + (familyRequirement * (applicants - 1));
  const monthlyRequirementEUR = totalRequirementEUR / 12;

  const qualifies = annualIncomeEUR >= totalRequirementEUR;
  const progressPercent = Math.min((annualIncomeEUR / totalRequirementEUR) * 100, 100);

  const resultsDiv = document.getElementById('dnv-results');
  resultsDiv.classList.add('show');

  document.getElementById('dnv-result-icon').textContent = qualifies ? '✅' : '⚠️';
  document.getElementById('dnv-result-title').textContent = qualifies ? 'You Qualify!' : 'Income Below Requirement';
  document.getElementById('dnv-required-eur').textContent = formatCurrency(totalRequirementEUR, 'EUR');
  document.getElementById('dnv-your-income').textContent = formatCurrency(annualIncomeEUR, 'EUR');
  document.getElementById('dnv-your-income-currency').textContent = currency;
  document.getElementById('dnv-required-monthly').textContent = formatCurrency(monthlyRequirementEUR, 'EUR');
  document.getElementById('dnv-status-badge').textContent = qualifies ? '✅ Qualifies' : '⚠️ Below';
  document.getElementById('dnv-status-badge').style.color = qualifies ? '#22c55e' : '#ef4444';

  document.getElementById('dnv-progress-fill').style.width = progressPercent + '%';
  document.getElementById('dnv-progress-fill').textContent = Math.round(progressPercent) + '%';

  document.getElementById('dnv-primary-req').textContent = formatCurrency(primaryRequirement, 'EUR');
  document.getElementById('dnv-family-req').textContent = applicants > 1 ? formatCurrency(familyRequirement * (applicants - 1), 'EUR') : '€0';
  document.getElementById('dnv-total-req').textContent = formatCurrency(totalRequirementEUR, 'EUR');

  document.getElementById('dnv-annual-converted').textContent = formatCurrency(annualIncomeEUR, 'EUR');
  const difference = annualIncomeEUR - totalRequirementEUR;
  const differenceText = difference >= 0 ? '+' + formatCurrency(difference, 'EUR') : '-' + formatCurrency(Math.abs(difference), 'EUR');
  document.getElementById('dnv-difference').textContent = differenceText;
  document.getElementById('dnv-difference').style.color = difference >= 0 ? '#22c55e' : '#ef4444';

  // Beckham Law Comparison
  if (useBeckham) {
    const beckhamComparison = document.getElementById('dnv-beckham-comparison');
    const regularTax = annualIncomeEUR * 0.30; // Approximate
    const beckhamTax = annualIncomeEUR * 0.24;
    const savings = regularTax - beckhamTax;

    beckhamComparison.innerHTML = `
      <div class="dnv-beckham-note">
        <h4>Beckham Law Tax Benefit</h4>
        <p>With the Beckham Law special tax regime, your estimated annual tax would be <strong>${formatCurrency(beckhamTax, 'EUR')}</strong> (24% flat rate) instead of approximately <strong>${formatCurrency(regularTax, 'EUR')}</strong> under regular Spanish taxation. Potential annual savings: <strong>${formatCurrency(savings, 'EUR')}</strong>.</p>
      </div>
    `;
  } else {
    document.getElementById('dnv-beckham-comparison').innerHTML = '';
  }

  window.scrollTo({ top: resultsDiv.offsetTop - 100, behavior: 'smooth' });
}

document.addEventListener('keypress', function(e) {
  if (e.key === 'Enter' && document.activeElement.id === 'dnv-monthly-income') {
    calculateDNV();
  }
});
</script>

