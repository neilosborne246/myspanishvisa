.msv__cta-band p { color: rgba(255,255,255,0.75) !important; max-width: 560px; margin: 1rem auto 2.2rem; font-size: 1rem; }
.msv__cta-band .msv__btn-group { justify-content: center; }
/* ── Related guides ──────────────────────────────────────────── */
.msv__related { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.2rem; }
@media (max-width: 860px) { .msv__related { grid-template-columns: 1fr 1fr; } }
@media (max-width: 420px) { .msv__related { grid-template-columns: 1fr; } }
.msv__related-card { background: var(--white); border: 1px solid var(--border); border-radius: 10px; padding: 1.3rem 1.25rem; text-decoration: none !important; transition: box-shadow 0.2s, transform 0.2s; display: block; }
.msv__related-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); text-decoration: none !important; }
