/* ── Disclaimer ──────────────────────────────────────────────── */
.msv__disclaimer { background: var(--cream); border-top: 1px solid var(--border); padding: 2rem 0; }
.msv__disclaimer p { font-size: 0.78rem; color: var(--muted); margin: 0; line-height: 1.65; }
</style>

